{
  "name": "pyai.site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "pyai.site - 个人博客 · 知识库 · 项目",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "npm run lint:code && npm run lint:policy",
    "lint:code": "eslint --config meta/lint/project-eslint.mjs src scripts test meta/lint astro.config.ts",
    "lint:policy": "node scripts/check-policy.mjs",
    "typecheck:policy": "tsc -p tsconfig.test.json",
    "test": "node --test --test-isolation=none \"test/*.test.ts\"",
    "verify": "npm run lint && npm run check && npm run typecheck:policy && npm test && npm run test:gate && npm run build",
    "preview": "astro preview",
    "astro": "astro",
    "test:report": "node --test --test-isolation=none --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-report.xml \"test/*.test.ts\"",
    "test:gate": "node scripts/security-gate.mjs --self-test"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
