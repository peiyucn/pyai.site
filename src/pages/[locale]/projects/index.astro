---
import ListLayout from '../../../layouts/ListLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import { getProjects, getProjectsMeta } from '../../../utils/content';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const projects = await getProjects(locale);

// 最近一次 GitHub Action 同步时间（data/projects/meta.json 由 projects-sync workflow 写入）
function formatSyncTime(iso: string): string {
  const d = new Date(new Date(iso).getTime() + 8 * 3600 * 1000);
  const pad = (n: number) => String(n).padStart(2, '0');
  return `${d.getUTCFullYear()}-${d.getUTCMonth() + 1}-${d.getUTCDate()} ${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}`;
}
const meta = getProjectsMeta();
const syncNote = meta.updatedAt
  ? t(locale, 'projects.lastUpdated', { date: formatSyncTime(meta.updatedAt) })
  : undefined;
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={t(locale, 'projects.title')}
  description={t(locale, 'projects.description')}
  syncNote={syncNote}
>
  {
    projects.length > 0 ? (
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
      </div>
    ) : (
      <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
    )
  }
</ListLayout>
