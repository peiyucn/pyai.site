---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { type Locale } from '../../../i18n/ui';
import { findTranslation, stripLocale } from '../../../utils/content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes
    .filter((note) => !note.data.draft)
    .map((note) => ({
      params: { locale: note.data.locale, slug: stripLocale(note.id) },
      props: { note },
    }));
}

const { note } = Astro.props as { note: any };
const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const translation = await findTranslation(note, otherLocale);
const translationUrl = translation
  ? `/${otherLocale}/notes/${stripLocale(translation.id)}/`
  : undefined;

const { Content } = await render(note);
---

<PostLayout
  entry={note}
  locale={locale}
  pathname={pathname}
  translationUrl={translationUrl}
  backHref={`/${locale}/notes/`}
>
  <Content />
</PostLayout>
