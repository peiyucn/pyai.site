---
import Base from '../../layouts/Base.astro';
// 首页：单屏深色月食 Hero（黑底 + 金色光弧 + 星点粒子），不展示具体内容
import MoonshotHero from '../../components/MoonshotHero.astro'; // 月食动画（文字带 + 光弧跟随）
import ParticleBackground from '../../components/ParticleBackground.astro'; // 深色星点粒子
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import DeepSeekLogo from '../../components/DeepSeekLogo.astro';
import type { Locale, UIKey } from '../../i18n/ui';
import { t } from '../../i18n/utils';

// 生成 zh / en 两套主页
export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

// 首页导航：以药丸形式放在 Hero 中间（不含"首页"自身）
const pills: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];
---

<Base
  title="pyai.site"
  description={t(locale, 'footer.tagline')}
  locale={locale}
  pathname={pathname}
  hideHeader
  hideFooter
>
  <!-- 深色 Hero：日全食动画（含 pyai.site 大标题）+ 星点粒子 + 内容层 -->
  <section class="hero-section">
    <div class="hero-bg" aria-hidden="true">
      <ParticleBackground variant="dark" />
    </div>
    <div class="hero-anim">
      <MoonshotHero />
    </div>
    <div class="hero-content">
      <p class="hero-tagline animate-in">
        {t(locale, 'footer.tagline')}
      </p>
      <p class="hero-working animate-in">
        <span class="hero-working-text">{t(locale, 'hero.workingWith')}</span>
        <DeepSeekLogo icon />
        <DeepSeekLogo text />
      </p>
      <nav class="hero-nav animate-in" aria-label="Main navigation">
        <div class="hero-pills">
          {
            pills.map((pill) => (
              <a
                href={pill.href}
                class:list={[
                  'hero-pill',
                  pill.key === 'nav.about' && 'hero-pill-about',
                ]}
              >
                {t(locale, pill.key)}
              </a>
            ))
          }
        </div>
        <LanguageSwitcher locale={locale} pathname={pathname} dark />
      </nav>
    </div>
  </section>
</Base>

<style>
  /* ===== 深色 Hero：月食动画 + 星点粒子 + 内容层 ===== */
  /* 首页单屏不滚动，无需全局的 scrollbar-gutter: stable 占位；
     否则该槽位会透出 body 浅色背景，在深色 hero 右侧形成白色竖条 */
  :global(html) {
    scrollbar-gutter: auto;
  }
  .hero-section {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 精确单屏：不触发滚动条 */
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: #000;
    color: #edebe4;
  }
  /* 黑洞动画层：全屏铺满（含 pyai.site 大标题），最底层 */
  .hero-anim {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  /* 星点粒子背景层：覆盖在动画之上、内容之下（否则被黑洞黑底 canvas 盖住看不见） */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* 内容层：浮在最上，副标题 + 按钮靠下 */
  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 1.25rem clamp(2.5rem, 9vh, 5rem);
    pointer-events: none; /* 空白区域不挡日食视觉 */
  }
  .hero-content :global(a),
  .hero-content :global(button) {
    pointer-events: auto; /* 按钮可交互 */
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: #c9c4b8;
    max-width: 36em;
    margin: 0 auto;
  }
  /* 技术署名 */
  .hero-working {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    color: #9b968a;
    letter-spacing: 0.02em;
  }
  .hero-working :global(.ds-logo) {
    width: 1.45em;
    height: 1.45em;
    flex: none;
    color: #4d6bfe;
  }
  .hero-working :global(.ds-text) {
    height: 1.17em;
    width: auto;
    flex: none;
    color: #4d6bfe;
    /* 缩小鲸鱼与 DeepSeek 文字之间的间距（.hero-working gap 0.4em 偏宽） */
    margin-left: -0.18em;
  }
  /* 导航区 */
  .hero-nav {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  /* 药丸导航：金色渐变（呼应月食），深色文字 */
  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1.5px solid transparent;
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) border-box;
    padding: calc(0.6em - 1.5px) calc(1.8em - 1.5px);
    font-size: 1rem;
    font-weight: 600;
    color: #2a1a06;
  }
  .hero-pill:hover {
    color: #2a1a06;
    text-decoration: none;
  }
  /* hover 时边框变为单束亮弧 */
  .hero-pill:hover {
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.18) 40deg,
        rgba(255, 255, 255, 0.95) 85deg,
        rgba(255, 255, 255, 0.4) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    animation: pill-sweep 2s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes pill-sweep {
    to {
      --angle: 360deg;
    }
  }
  /* "关于"按钮：不透明暖白底 + 深色文字（呼应原版"白底"关于按钮）。
     与金色按钮"金底深字"区分，且不透明底能挡住黑底。 */
  .hero-pill-about {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      linear-gradient(#f4f0e8, #f4f0e8) border-box;
    color: #241a0c;
  }
  /* 关于按钮 hover：与其他按钮行为一致 —— 颜色完全不变，仅边框变为金色光弧转动。
     暖白底不透明，conic 透明段透出暖白而非黑底（无雷达），金色弧与"金底白弧"镜像互补。 */
  .hero-pill-about:hover {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.22) 40deg,
        rgba(255, 212, 138, 0.95) 85deg,
        rgba(240, 185, 94, 0.55) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    /* 覆盖 .hero-pill:hover 的文字色（其特异性更高），保证关于按钮文字颜色真正固定 */
    color: #241a0c;
    animation: pill-sweep 2s linear infinite;
  }

  /* 渐入动画：延迟递增制造层叠感 */
  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-tagline {
      font-size: 1.1rem;
    }
  }
</style>
