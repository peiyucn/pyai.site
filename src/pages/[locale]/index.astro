---
import Base from '../../layouts/Base.astro';
// 首页背景动效：粒子网络 / 极光光幕 / 两者叠加
import ParticleBackground from '../../components/ParticleBackground.astro'; // 粒子连线网络
import AuroraFlow from '../../components/AuroraFlow.astro'; // 极光光幕
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import type { Locale, UIKey } from '../../i18n/ui';
import { t } from '../../i18n/utils';

// ============================================================
// 首页背景动效切换：'particles' | 'aurora' | 'combined'
// ============================================================
const HOME_EFFECT = 'combined';

const effectComponents: Record<string, any> = {
  particles: ParticleBackground,
  aurora: AuroraFlow,
};
const EffectComponent = effectComponents[HOME_EFFECT] ?? ParticleBackground;

// 生成 zh / en 两套主页
export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

// 首页导航：以药丸形式放在 Hero 中间（不含"首页"自身）
const pills: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];
---

<Base
  title="pyai.site"
  description={t(locale, 'footer.tagline')}
  locale={locale}
  pathname={pathname}
  hideHeader
  hideFooter
>
  <!-- 极简首页：仅 Hero（背景动效 + logo + 副标题 + 药丸导航） -->
  <section class="hero-section">
    {
      HOME_EFFECT === 'combined' ? (
        <>
          {/* 底层：粒子连线网络 */}
          <ParticleBackground />
          {/* 上层：极光光幕（大块模糊紫光流动） */}
          <AuroraFlow />
        </>
      ) : (
        <EffectComponent />
      )
    }
    <div class="hero-content mx-auto flex max-w-3xl flex-col items-center px-5 text-center">
      <h1 class="hero-logo animate-in">
        pyai<span class="text-gradient">.site</span><span class="hero-caret" aria-hidden="true"></span>
      </h1>
      <p class="hero-tagline animate-in">
        {t(locale, 'footer.tagline')}
      </p>
      <nav class="mt-10 flex flex-col items-center gap-4 animate-in" aria-label="Main navigation">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {
            pills.map((pill) => (
              <a
                href={pill.href}
                class:list={[
                  'hero-pill',
                  pill.key === 'nav.about' && 'hero-pill-about',
                ]}
              >
                {t(locale, pill.key)}
              </a>
            ))
          }
        </div>
        <LanguageSwitcher locale={locale} pathname={pathname} />
      </nav>
    </div>
  </section>
</Base>

<style>
  /* 极简首页：全屏 Hero，内容垂直居中，不触发滚动条 */
  .hero-section {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    /* 无顶部导航：精确占满整个视口 */
    height: 100vh;
    width: 100%;
    /* 背景：灰白基调 + 极淡的光晕 */
    background:
      radial-gradient(ellipse 60% 40% at 20% 20%, rgba(99, 102, 241, 0.12), transparent 60%),
      radial-gradient(ellipse 50% 35% at 80% 25%, rgba(139, 92, 246, 0.1), transparent 60%),
      radial-gradient(ellipse 55% 40% at 50% 80%, rgba(167, 139, 250, 0.08), transparent 60%),
      #f6f5f2;
  }
  /* Hero 内容在粒子层之上 */
  .hero-content {
    position: relative;
    z-index: 2;
    /* 留出弹性空隙：内容超高时避免贴边 */
    padding-block: 1rem;
  }
  /* 大 logo：黑色 + 紫色渐变后缀（沿用菜单栏配色） */
  .hero-logo {
    display: inline-flex;
    align-items: center; /* 光标垂直居中于文字 */
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.4em;
    color: #18181b;
  }

  /* 打字机光标：黑色竖线，闪烁（对齐字母视觉主体，非整行高） */
  .hero-caret {
    display: inline-block;
    width: 0.09em;
    height: 0.72em;
    margin-left: 0.12em;
    background: #18181b; /* 与 logo 文字同色，方正无圆角 */
    /* 贴合小写字母主体：顶对齐后向下压，视觉居中 */
    transform: translateY(0.14em);
    animation: caret-blink 1.1s steps(2, start) infinite;
  }
  @keyframes caret-blink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }
  .hero-tagline {
    font-size: 1.25rem;
    color: var(--fg-muted);
    max-width: 36em;
    margin: 0 auto;
  }

  /* 药丸导航：紫色渐变主按钮 */
  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    /* 1.5px 细边框：默认与内部渐变完全一致（视觉无缝） */
    border: 1.5px solid transparent;
    background:
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) padding-box,
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) border-box;
    padding: calc(0.6em - 1.5px) calc(1.8em - 1.5px); /* 减去边框厚度，视觉尺寸不变 */
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
    transition: box-shadow 0.2s ease;
  }
  .hero-pill:hover {
    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.4);
    color: #fff;
    text-decoration: none;
  }
  /* hover 时边框变为单束亮弧：窄弧 + 柔和衰减，沿边缘转圈 */
  .hero-pill:hover {
    background:
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(167, 139, 250, 0.15) 40deg,
        rgba(255, 255, 255, 0.95) 85deg,
        rgba(255, 255, 255, 0.4) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    animation: pill-sweep 2s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes pill-sweep {
    to {
      --angle: 360deg;
    }
  }
  /* "关于"按钮：纯白底（用白色渐变表达，避免压缩器丢失纯色），与紫色渐变区分 */
  .hero-pill-about {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(#ffffff, #ffffff) border-box;
    color: var(--fg);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }
  .hero-pill-about:hover {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(139, 92, 246, 0.2) 40deg,
        rgba(167, 139, 250, 0.95) 85deg,
        rgba(99, 102, 241, 0.45) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    color: var(--accent);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.2);
    animation: pill-sweep 2s linear infinite;
  }

  /* 渐入动画：延迟递增制造层叠感 */
  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-logo {
      font-size: 2.8rem;
    }
    .hero-tagline {
      font-size: 1.1rem;
    }
  }
</style>
