      900px 880px rgba(255, 212, 138, 0.56),
      1400px 860px rgba(255, 212, 138, 0.50),
      1800px 900px rgba(255, 212, 138, 0.56);
  }
  /* 近景亮星：2px 更大更亮，与远/中两层形成纵深 */
  .hero-star-layer--3 {
    width: 2px;
    height: 2px;
    box-shadow:
      60px 120px rgba(255, 255, 255, 0.75),
      320px 60px rgba(255, 255, 255, 0.69),
      580px 180px rgba(255, 255, 255, 0.81),
      820px 90px rgba(255, 255, 255, 0.75),
