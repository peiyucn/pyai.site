---
import Base from '../../layouts/Base.astro';
// 首页：单屏深色月食 Hero（黑底 + 金色光弧 + 星点粒子），不展示具体内容
import MoonshotHero from '../../components/MoonshotHero.astro'; // 月食动画（文字带 + 光弧跟随）
import ParticleBackground from '../../components/ParticleBackground.astro'; // 深色星点粒子
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import GitHubLink from '../../components/GitHubLink.astro';
import DeepSeekLogo from '../../components/DeepSeekLogo.astro';
import type { Locale, UIKey } from '../../i18n/ui';
import { t } from '../../i18n/utils';

// 生成 zh / en 两套主页
export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

// 首页导航：以药丸形式放在 Hero 中间（不含"首页"自身）
const pills: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];
---

<Base
  title="pyai.site"
  description={t(locale, 'footer.tagline')}
  locale={locale}
  pathname={pathname}
  hideHeader
  hideFooter
>
  <!-- 深色 Hero：日全食动画（含 pyai.site 大标题）+ 星点粒子 + 内容层 -->
  <section class="hero-section">
    <div class="hero-anim">
      <MoonshotHero />
    </div>
    <!-- 移动端静态标题（无 WebGL 时的回退，像素字体） -->
    <div class="hero-static-title" aria-hidden="true">pyai.site</div>
    <!-- 星点层：复用内页 SpaceBackdrop 的 box-shadow 星点（颜色/亮度/密度一致），
         mask 径向挖洞让黑洞中心保持纯黑（跟随 --bh-x/--bh-y） -->
    <div class="hero-stars" aria-hidden="true">
      <div class="hero-star-layer hero-star-layer--1"></div>
      <div class="hero-star-layer hero-star-layer--2"></div>
      <div class="hero-star-layer hero-star-layer--3"></div>
      <div class="hero-star-twinkle" aria-hidden="true">
        <span class="twinkle-star" style="left: 10%; top: 15%; animation-duration: 0.35s; animation-delay: 0s;"></span>
        <span class="twinkle-star" style="left: 30%; top: 8%; animation-duration: 0.6s; animation-delay: 0.3s;"></span>
        <span class="twinkle-star" style="left: 62%; top: 10%; animation-duration: 0.9s; animation-delay: 0.7s;"></span>
        <span class="twinkle-star" style="left: 88%; top: 30%; animation-duration: 1.3s; animation-delay: 0.2s;"></span>
        <span class="twinkle-star" style="left: 92%; top: 72%; animation-duration: 0.45s; animation-delay: 0.5s;"></span>
        <span class="twinkle-star" style="left: 70%; top: 88%; animation-duration: 0.75s; animation-delay: 0.9s;"></span>
        <span class="twinkle-star" style="left: 45%; top: 92%; animation-duration: 1.1s; animation-delay: 1.2s;"></span>
        <span class="twinkle-star" style="left: 12%; top: 80%; animation-duration: 1.5s; animation-delay: 0.4s;"></span>
      </div>
    </div>
    <div class="hero-bg" aria-hidden="true">
      <ParticleBackground variant="dark" />
    </div>
    <div class="hero-content">
      <p class="hero-tagline animate-in">
        {t(locale, 'footer.tagline')}
      </p>
      <p class="hero-working animate-in">
        <span class="hero-working-text">{t(locale, 'hero.workingWith')}</span>
        <DeepSeekLogo icon />
        <DeepSeekLogo text />
      </p>
      <nav class="hero-nav animate-in" aria-label="Main navigation">
        <div class="hero-pills">
          {
            pills.map((pill) => (
              <a
                href={pill.href}
                class:list={[
                  'hero-pill',
                  pill.key === 'nav.about' && 'hero-pill-about',
                ]}
              >
                {t(locale, pill.key)}
              </a>
            ))
          }
        </div>
        <div class="hero-nav-bottom">
          <GitHubLink />
          <LanguageSwitcher locale={locale} pathname={pathname} dark />
        </div>
      </nav>
    </div>
  </section>
</Base>

<style>
  /* ===== 深色 Hero：月食动画 + 星点粒子 + 内容层 ===== */
  /* 首页单屏不滚动，无需全局的 scrollbar-gutter: stable 占位；
     否则该槽位会透出 body 浅色背景，在深色 hero 右侧形成白色竖条 */
  :global(html) {
    scrollbar-gutter: auto;
  }
  .hero-section {
    position: relative;
    display: flex;
    flex-direction: column;
    /* 精确单屏：不触发滚动条 */
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: #000;
    color: #edebe4;
  }
  /* 黑洞动画层：全屏铺满（含 pyai.site 大标题），最底层；
     就绪前透明，WebGL 初始化完成后淡入（MoonshotHero 加 .hero-anim-ready），避免"突然弹出" */
  .hero-anim {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .hero-anim.hero-anim-ready {
    opacity: 1;
  }
  /* 移动端静态标题（无 WebGL 时的回退）：像素字体，居中 */
  .hero-static-title {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
    white-space: nowrap;
    font-family: 'Fusion Pixel Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(2rem, 9vw, 4rem);
    letter-spacing: 0.02em;
    color: #edebe4;
  }
  /* 移动端：跳过 WebGL，显示静态标题 + 底部渐变 */
  @media (max-width: 768px) {
    .hero-anim {
      opacity: 1;
    }
    .hero-static-title {
      display: flex;
    }
  }
  /* 星点层：复用内页 SpaceBackdrop 的 box-shadow 星点（颜色/亮度/密度完全一致），
     mask 径向挖洞让黑洞中心保持纯黑（跟随 --bh-x/--bh-y CSS 变量，
     由 MoonshotHero 的 beam hook 每帧写入） */
  .hero-stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at var(--bh-x, 50%) var(--bh-y, 50%), transparent 0, transparent 28%, black 31%);
    mask-image: radial-gradient(circle at var(--bh-x, 50%) var(--bh-y, 50%), transparent 0, transparent 28%, black 31%);
  }
  .hero-star-layer {
