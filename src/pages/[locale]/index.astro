---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { getPosts, getNotes, getProjects } from '../../utils/content';

// 生成 zh / en 两套主页
export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const recentPosts = (await getPosts(locale)).slice(0, 3);
const recentNotes = (await getNotes(locale)).slice(0, 3);
const featuredProjects = (await getProjects(locale))
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<Base
  title="pyai.site"
  description={t(locale, 'home.heroSubtitle')}
  locale={locale}
  pathname={pathname}
>
  <!-- Hero -->
  <section class="px-5 pb-12 pt-16 text-center sm:pt-20">
    <div class="mx-auto flex max-w-2xl flex-col items-center animate-in">
      <p class="mb-3 text-5xl leading-none">👋</p>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        {t(locale, 'home.heroTitle')}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-zinc-500 dark:text-zinc-400">
        {t(locale, 'home.heroSubtitle')}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={`/${locale}/blog/`}
          class="rounded-full bg-accent px-6 py-2.5 text-base font-semibold text-white shadow-md transition-all hover:-translate-y-0.5 hover:no-underline hover:shadow-lg dark:bg-indigo-500"
        >
          {t(locale, 'nav.blog')} →
        </a>
        <a
          href={`/${locale}/about/`}
          class="rounded-full border border-zinc-200 bg-white px-6 py-2.5 text-base font-medium text-zinc-700 transition-all hover:-translate-y-0.5 hover:no-underline hover:shadow-md dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300"
        >
          {t(locale, 'nav.about')}
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-2 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">✍️</span> {t(locale, 'home.recentPosts')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/blog/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      recentPosts.length > 0 ? (
        recentPosts.map((post) => <PostCard post={post} locale={locale} />)
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>

  <!-- 最近笔记 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-2 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">📚</span> {t(locale, 'home.recentNotes')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/notes/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      recentNotes.length > 0 ? (
        recentNotes.map((note) => <NoteCard note={note} locale={locale} />)
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>

  <!-- 精选项目 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-3 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">🚀</span> {t(locale, 'home.featuredProjects')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/projects/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      featuredProjects.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))
          }
        </div>
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>
</Base>

<style>
  /* 主页样式已使用 Tailwind utility class，此 style 仅保留少量补充 */
</style>
