---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NoteCard from '../../components/NoteCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { getPosts, getNotes, getProjects } from '../../utils/content';

// 生成 zh / en 两套主页
export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const recentPosts = (await getPosts(locale)).slice(0, 3);
const recentNotes = (await getNotes(locale)).slice(0, 3);
const featuredProjects = (await getProjects(locale))
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<Base
  title="pyai.site"
  description={t(locale, 'home.heroSubtitle')}
  locale={locale}
  pathname={pathname}
>
  <!-- Hero：粒子 + 光晕 + 动效 -->
  <section class="hero-section">
    <ParticleBackground />
    <div class="hero-content mx-auto flex max-w-3xl flex-col items-center px-5 text-center">
      <p class="hero-badge animate-in">👋</p>
      <h1 class="hero-title animate-in text-gradient">
        {t(locale, 'home.heroTitle')}
      </h1>
      <p class="hero-subtitle animate-in">
        {t(locale, 'home.heroSubtitle')}
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4 animate-in">
        <a
          href={`/${locale}/blog/`}
          class="hero-btn-primary"
        >
          {t(locale, 'nav.blog')} →
        </a>
        <a
          href={`/${locale}/about/`}
          class="hero-btn-secondary"
        >
          {t(locale, 'nav.about')}
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-2 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">✍️</span> {t(locale, 'home.recentPosts')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/blog/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      recentPosts.length > 0 ? (
        recentPosts.map((post) => <PostCard post={post} locale={locale} />)
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>

  <!-- 最近笔记 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-2 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">📚</span> {t(locale, 'home.recentNotes')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/notes/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      recentNotes.length > 0 ? (
        recentNotes.map((note) => <NoteCard note={note} locale={locale} />)
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>

  <!-- 精选项目 -->
  <section class="mx-auto max-w-3xl px-5 py-6 animate-in">
    <div class="mb-3 flex items-baseline justify-between gap-4 border-b border-zinc-200 pb-3 dark:border-zinc-800">
      <h2 class="text-xl font-bold tracking-tight">
        <span class="mr-1.5">🚀</span> {t(locale, 'home.featuredProjects')}
      </h2>
      <a class="whitespace-nowrap text-sm font-medium text-zinc-500 hover:no-underline hover:text-accent dark:text-zinc-400" href={`/${locale}/projects/`}>
        {t(locale, 'common.viewAll')} →
      </a>
    </div>
    {
      featuredProjects.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            featuredProjects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))
          }
        </div>
      ) : (
        <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
      )
    }
  </section>
</Base>

<style>
  /* 炫酷 Hero：光晕渐变 + 粒子 + 动效 */
  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    text-align: center;
    /* 兜底宽度：确保即使在异常容器下也有尺寸 */
    width: 100%;
    /* 背景：多层径向渐变光晕 */
    background:
      radial-gradient(ellipse 60% 40% at 20% 20%, rgba(79, 70, 229, 0.35), transparent 60%),
      radial-gradient(ellipse 50% 35% at 80% 25%, rgba(124, 58, 237, 0.3), transparent 60%),
      radial-gradient(ellipse 55% 40% at 50% 80%, rgba(219, 39, 119, 0.2), transparent 60%),
      var(--bg);
  }
  @media (prefers-color-scheme: dark) {
    .hero-section {
      background:
        radial-gradient(ellipse 60% 40% at 20% 20%, rgba(99, 102, 241, 0.3), transparent 60%),
        radial-gradient(ellipse 50% 35% at 80% 25%, rgba(168, 85, 247, 0.25), transparent 60%),
        radial-gradient(ellipse 55% 40% at 50% 80%, rgba(244, 114, 182, 0.15), transparent 60%),
        var(--bg);
    }
  }
  /* Hero 内容在粒子层之上 */
  .hero-content {
    position: relative;
    z-index: 1;
  }
  .hero-badge {
    font-size: 3rem;
    line-height: 1;
    margin-bottom: 0.8rem;
  }
  .hero-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin: 0 0 0.6em;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--fg-muted);
    max-width: 36em;
    margin: 0 auto;
  }
  .hero-btn-primary {
    border-radius: 9999px;
    background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 50%, #db2777 100%);
    padding: 0.7em 2em;
    font-size: 1.05rem;
    font-weight: 600;
    color: #fff;
    box-shadow: 0 4px 20px rgba(79, 70, 229, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(79, 70, 229, 0.5);
    text-decoration: none;
  }
  .hero-btn-secondary {
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(8px);
    padding: 0.7em 2em;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--fg);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  @media (prefers-color-scheme: dark) {
    .hero-btn-secondary {
      background: rgba(24, 24, 27, 0.6);
    }
  }
  .hero-btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    text-decoration: none;
  }

  /* 渐入动画：延迟递增制造层叠感 */
  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 4rem 0 3.5rem;
    }
    .hero-title {
      font-size: 2.4rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
  }
</style>
