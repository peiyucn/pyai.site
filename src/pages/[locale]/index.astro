  /* 闪烁星点：少数几颗独立闪烁（各自节奏不同），营造"活"的星空 */
  .hero-star-twinkle {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }
  .twinkle-star {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.55);
    animation-name: star-twinkle;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
    animation-duration: 0.7s;
  }
  @keyframes star-twinkle {
    0%, 100% { opacity: 0.7; }
    8%  { opacity: 0.3; }
    19% { opacity: 0.75; }
    27% { opacity: 0.45; }
    38% { opacity: 0.9; }
    47% { opacity: 0.55; }
    58% { opacity: 0.25; }
    69% { opacity: 0.8; }
    78% { opacity: 0.4; }
    88% { opacity: 0.65; }
  }
  /* 星点粒子背景层：覆盖在动画之上、内容之下（否则被黑洞黑底 canvas 盖住看不见） */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  /* 内容层：浮在最上，副标题 + 按钮靠下 */
  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 1.25rem clamp(2.5rem, 9vh, 5rem);
    pointer-events: none; /* 空白区域不挡日食视觉 */
  }
  .hero-content :global(a),
  .hero-content :global(button) {
    pointer-events: auto; /* 按钮可交互 */
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: #c9c4b8;
    max-width: 36em;
    margin: 0 auto;
  }
  /* 技术署名 */
  .hero-working {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    color: #9b968a;
    letter-spacing: 0.02em;
  }
  .hero-working :global(.ds-logo) {
    width: 1.45em;
    height: 1.45em;
    flex: none;
    color: #fff;
  }
  .hero-working :global(.ds-text) {
    height: 1.17em;
    width: auto;
    flex: none;
    color: #fff;
    /* 缩小鲸鱼与 DeepSeek 文字之间的间距（.hero-working gap 0.4em 偏宽） */
    margin-left: -0.18em;
  }
  /* 导航区 */
  .hero-nav {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero-nav-bottom {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }
  /* 药丸导航：金色渐变（呼应月食），深色文字 */
  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1.5px solid transparent;
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) border-box;
    padding: calc(0.6em - 1.5px) calc(1.8em - 1.5px);
    font-size: 1rem;
    font-weight: 600;
    color: #2a1a06;
  }
  .hero-pill:hover {
    color: #2a1a06;
    text-decoration: none;
  }
  /* hover 时边框变为单束亮弧 */
  .hero-pill:hover {
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.18) 40deg,
        rgba(255, 255, 255, 0.95) 85deg,
        rgba(255, 255, 255, 0.4) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    animation: pill-sweep 2s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes pill-sweep {
    to {
      --angle: 360deg;
    }
  }
  /* "关于"按钮：不透明暖白底 + 深色文字（呼应原版"白底"关于按钮）。
     与金色按钮"金底深字"区分，且不透明底能挡住黑底。 */
  .hero-pill-about {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      linear-gradient(#f4f0e8, #f4f0e8) border-box;
    color: #241a0c;
  }
  /* 关于按钮 hover：与其他按钮行为一致 —— 颜色完全不变，仅边框变为金色光弧转动。
     暖白底不透明，conic 透明段透出暖白而非黑底（无雷达），金色弧与"金底白弧"镜像互补。 */
  .hero-pill-about:hover {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.22) 40deg,
        rgba(255, 212, 138, 0.95) 85deg,
        rgba(240, 185, 94, 0.55) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    /* 覆盖 .hero-pill:hover 的文字色（其特异性更高），保证关于按钮文字颜色真正固定 */
    color: #241a0c;
    animation: pill-sweep 2s linear infinite;
  }

  /* 渐入动画：延迟递增制造层叠感 */
  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-tagline {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // 星点视差：星星跟随黑洞（window.__pyaiBH，由 MoonshotHero 每帧写入）做小幅度位移。
  // 三层幅度递减（越远越小），与黑洞的大幅移动形成空间纵深。
  (() => {
    const LAYERS = [
      { selector: '.hero-star-layer--1', factor: 0.08 }, // 远
      { selector: '.hero-star-layer--2', factor: 0.16 }, // 中
      { selector: '.hero-star-layer--3', factor: 0.24 }, // 近
      { selector: '.hero-star-twinkle', factor: 0.24 }, // 闪烁星（跟随近景）
    ];
    let rafId = 0;
    // 全局位移量：统一缩放星星的移动幅度（1.0 = 当前默认），
    // 调大/调小整体放大/缩小，不改变三层之间的相对比例。
    const AMOUNT = 1.0;

    function apply() {
      const bh = window.__pyaiBH;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      for (const { selector, factor } of LAYERS) {
        const el = document.querySelector(selector);
        if (!el) continue;
        if (!bh) {
          el.style.transform = '';
          continue;
        }
        const ox = bh.x - 0.5; // 黑洞偏移（UV 归一化，中心 0.5）
        const oy = bh.y - 0.5; // y 向上为正
        const tx = ox * factor * AMOUNT * vw;
        const ty = -oy * factor * AMOUNT * vh; // CSS y 向下为正 → 取反
        el.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      }
    }

    function loop() {
      if (!document.querySelector('.hero-star-layer--1')) {
        rafId = 0; // 已离开首页，停止空转
        return;
      }
      apply();
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (rafId) return;
      rafId = requestAnimationFrame(loop);
    }

    start();
    document.addEventListener('astro:page-load', start);
  })();
</script>
