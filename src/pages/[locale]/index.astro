      1280px 60px rgba(255, 255, 255, 0.81),
      1500px 170px rgba(255, 255, 255, 0.75),
      1720px 80px rgba(255, 255, 255, 0.69),
      1900px 200px rgba(255, 255, 255, 0.75),
      240px 380px rgba(255, 255, 255, 0.69),
