---
import Base from '../../layouts/Base.astro';

import MoonshotHero from '../../components/MoonshotHero.astro';
import ParticleBackground from '../../components/ParticleBackground.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import GitHubLink from '../../components/GitHubLink.astro';
import DeepSeekLogo from '../../components/DeepSeekLogo.astro';
import type { Locale, UIKey } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { heroFar, heroMid, heroNear, starShadows } from '../../data/stars';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const pills: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];

const heroFarShadows = starShadows(heroFar, '255, 255, 255');
const heroMidShadows = starShadows(heroMid, '255, 212, 138');
const heroNearShadows = starShadows(heroNear, '255, 255, 255');
---

<Base
  title="pyai.site"
  description={t(locale, 'footer.tagline')}
  locale={locale}
  pathname={pathname}
  hideHeader
  hideFooter
>

  <section class="hero-section">
    <div class="hero-anim">
      <MoonshotHero />
    </div>

    <div class="hero-static-title" aria-hidden="true">pyai.site</div>

    <div class="hero-stars" aria-hidden="true">
      <div class="hero-star-layer hero-star-layer--1" style={`box-shadow: ${heroFarShadows}`}></div>
      <div class="hero-star-layer hero-star-layer--2" style={`box-shadow: ${heroMidShadows}`}></div>
      <div class="hero-star-layer hero-star-layer--3" style={`box-shadow: ${heroNearShadows}`}></div>
      <div class="hero-star-twinkle" aria-hidden="true">
        <span class="twinkle-star" style="left: 10%; top: 15%; animation-duration: 0.35s; animation-delay: 0s;"></span>
        <span class="twinkle-star" style="left: 30%; top: 8%; animation-duration: 0.6s; animation-delay: 0.3s;"></span>
        <span class="twinkle-star" style="left: 62%; top: 10%; animation-duration: 0.9s; animation-delay: 0.7s;"></span>
        <span class="twinkle-star" style="left: 88%; top: 30%; animation-duration: 1.3s; animation-delay: 0.2s;"></span>
        <span class="twinkle-star" style="left: 92%; top: 72%; animation-duration: 0.45s; animation-delay: 0.5s;"></span>
        <span class="twinkle-star" style="left: 70%; top: 88%; animation-duration: 0.75s; animation-delay: 0.9s;"></span>
        <span class="twinkle-star" style="left: 45%; top: 92%; animation-duration: 1.1s; animation-delay: 1.2s;"></span>
        <span class="twinkle-star" style="left: 12%; top: 80%; animation-duration: 1.5s; animation-delay: 0.4s;"></span>
      </div>
    </div>
    <div class="hero-bg" aria-hidden="true">
      <ParticleBackground variant="dark" />
    </div>
    <div class="hero-content">
      <p class="hero-tagline animate-in">
        {t(locale, 'footer.tagline')}
      </p>
      <p class="hero-working animate-in">
        <span class="hero-working-text">{t(locale, 'hero.workingWith')}</span>
        <DeepSeekLogo icon />
        <DeepSeekLogo text />
      </p>
      <nav class="hero-nav animate-in" aria-label="Main navigation">
        <div class="hero-pills">
          {
            pills.map((pill) => (
              <a
                href={pill.href}
                class:list={[
                  'hero-pill',
                  pill.key === 'nav.about' && 'hero-pill-about',
                ]}
              >
                {t(locale, pill.key)}
              </a>
            ))
          }
        </div>
        <div class="hero-nav-bottom">
          <GitHubLink />
          <LanguageSwitcher locale={locale} pathname={pathname} dark />
        </div>
      </nav>
    </div>
  </section>
</Base>

<style>

  :global(html) {
    scrollbar-gutter: auto;
  }
  .hero-section {
    position: relative;
    display: flex;
    flex-direction: column;

    height: 100vh;
    width: 100%;
    overflow: hidden;
    background: #000;
    color: #edebe4;
  }

  .hero-anim {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .hero-anim.hero-anim-ready {
    opacity: 1;
  }

  .hero-static-title {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
    white-space: nowrap;
    font-family: 'Fusion Pixel Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(2rem, 9vw, 4rem);
    letter-spacing: 0.02em;
    color: #edebe4;
  }

  .hero-stars {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(circle at var(--bh-x, 50%) var(--bh-y, 50%), transparent 0, transparent 28%, black 31%);
    mask-image: radial-gradient(circle at var(--bh-x, 50%) var(--bh-y, 50%), transparent 0, transparent 28%, black 31%);
  }
  .hero-star-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: transparent;
    will-change: transform;
  }

  .hero-star-layer--3 {
    width: 2px;
    height: 2px;
  }

  .hero-star-twinkle {
    position: absolute;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }
  .twinkle-star {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 3px rgba(255, 255, 255, 0.55);
    animation-name: star-twinkle;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
    animation-duration: 0.7s;
  }
  @keyframes star-twinkle {
    0%, 100% { opacity: 0.7; }
    8%  { opacity: 0.3; }
    19% { opacity: 0.75; }
    27% { opacity: 0.45; }
    38% { opacity: 0.9; }
    47% { opacity: 0.55; }
    58% { opacity: 0.25; }
    69% { opacity: 0.8; }
    78% { opacity: 0.4; }
    88% { opacity: 0.65; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 1.25rem clamp(2.5rem, 9vh, 5rem);
    pointer-events: none;
  }
  .hero-content :global(a),
  .hero-content :global(button) {
    pointer-events: auto;
  }

  .hero-tagline {
    font-size: 1.25rem;
    color: #c9c4b8;
    max-width: 36em;
    margin: 0 auto;
  }

  .hero-working {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    color: #9b968a;
    letter-spacing: 0.02em;
  }
  .hero-working :global(.ds-logo) {
    width: 1.45em;
    height: 1.45em;
    flex: none;
    color: #fff;
  }
  .hero-working :global(.ds-text) {
    height: 1.17em;
    width: auto;
    flex: none;
    color: #fff;

    margin-left: -0.18em;
  }

  .hero-nav {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .hero-nav-bottom {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .hero-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1.5px solid transparent;
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) border-box;
    padding: calc(0.6em - 1.5px) calc(1.8em - 1.5px);
    font-size: 1rem;
    font-weight: 600;
    color: #2a1a06;
  }
  .hero-pill:hover {
    color: #2a1a06;
    text-decoration: none;
  }

  .hero-pill:hover {
    background:
      linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.18) 40deg,
        rgba(255, 255, 255, 0.95) 85deg,
        rgba(255, 255, 255, 0.4) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    animation: pill-sweep 2s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes pill-sweep {
    to {
      --angle: 360deg;
    }
  }

  .hero-pill-about {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      linear-gradient(#f4f0e8, #f4f0e8) border-box;
    color: #241a0c;
  }

  .hero-pill-about:hover {
    background:
      linear-gradient(#f4f0e8, #f4f0e8) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(255, 212, 138, 0.22) 40deg,
        rgba(255, 212, 138, 0.95) 85deg,
        rgba(240, 185, 94, 0.55) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;

    color: #241a0c;
    animation: pill-sweep 2s linear infinite;
  }

  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-tagline {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 768px) {
    .hero-anim {
      opacity: 1;
    }
    .hero-static-title {
      display: flex;
      position: relative;
      inset: auto;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden;
    }
    .hero-content {
      position: relative;
      inset: auto;
      flex: 0 0 auto;
    }
  }
</style>

<script>

  (() => {
    const LAYERS = [
      { selector: '.hero-star-layer--1', factor: 0.08 },
      { selector: '.hero-star-layer--2', factor: 0.16 },
      { selector: '.hero-star-layer--3', factor: 0.24 },
      { selector: '.hero-star-twinkle', factor: 0.24 },
    ];
    let rafId = 0;

    const AMOUNT = 1.0;

    function apply() {
      const bh = window.__pyaiBH;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      for (const { selector, factor } of LAYERS) {
        const el = document.querySelector<HTMLElement>(selector);
        if (!el) continue;
        if (!bh) {
          el.style.transform = '';
          continue;
        }
        const ox = bh.x - 0.5;
        const oy = bh.y - 0.5;
        const tx = ox * factor * AMOUNT * vw;
        const ty = -oy * factor * AMOUNT * vh;
        el.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      }
    }

    function loop() {
      if (!document.querySelector('.hero-star-layer--1')) {
        rafId = 0;
        return;
      }
      apply();
      rafId = requestAnimationFrame(loop);
    }

    function start() {
      if (rafId) return;
      rafId = requestAnimationFrame(loop);
    }

    start();
    document.addEventListener('astro:page-load', start);
  })();
</script>
