          />
        </svg>
      </p>
      <nav class="mt-10 flex flex-col items-center gap-4 animate-in" aria-label="Main navigation">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {
            pills.map((pill) => (
              <a
                href={pill.href}
                class:list={[
                  'hero-pill',
                  pill.key === 'nav.about' && 'hero-pill-about',
                ]}
              >
                {t(locale, pill.key)}
              </a>
            ))
          }
        </div>
        <LanguageSwitcher locale={locale} pathname={pathname} />
      </nav>
    </div>

  </section>
</Base>

<style>
  /* 极简首页：全屏 Hero，内容垂直居中，不触发滚动条 */
  .hero-section {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    /* 无顶部导航：精确占满整个视口 */
    height: 100vh;
    width: 100%;
    /* 背景：灰白基调 + 极淡的光晕 */
    background:
      radial-gradient(ellipse 60% 40% at 20% 20%, rgba(99, 102, 241, 0.12), transparent 60%),
      radial-gradient(ellipse 50% 35% at 80% 25%, rgba(139, 92, 246, 0.1), transparent 60%),
      radial-gradient(ellipse 55% 40% at 50% 80%, rgba(167, 139, 250, 0.08), transparent 60%),
      #f6f5f2;
  }
  /* Hero 内容在粒子层之上 */
  .hero-content {
    position: relative;
    z-index: 2;
    /* 留出弹性空隙：内容超高时避免贴边 */
    padding-block: 1rem;
  }
  /* 大 logo：黑色 + 紫色渐变后缀（沿用菜单栏配色），
     景深阴影：深色投影 + 下方高光，营造悬浮层次感 */
  .hero-logo {
    display: inline-flex;
    align-items: center; /* 光标垂直居中于文字 */
    font-size: 4rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.4em;
    color: #18181b;
    /* pyai 黑色文字：暖黑景深投影（深色文字不会被压暗，浮起感明显） */
    text-shadow:
      0 1px 1px rgba(120, 113, 108, 0.35),
      0 2px 4px rgba(60, 50, 45, 0.18),
      0 10px 28px rgba(60, 50, 45, 0.14);
  }
  /* .site 渐变后缀：生产版亮色系（#6366f1 → #8b5cf6 → #a78bfa），
     悬浮 = 亮紫光晕（提亮）+ 深紫投影（同色相暗影，立体感但不显灰脏） */
  .hero-logo .text-gradient {
    background-image: linear-gradient(
      135deg,
      #6366f1 0%,
      #8b5cf6 50%,
      #a78bfa 100%
    );
    text-shadow:
      0 0 12px rgba(196, 181, 253, 0.5),
      0 2px 4px rgba(91, 60, 170, 0.35),
      0 6px 16px rgba(91, 60, 170, 0.3);
  }

  /* 打字机光标：黑色竖线，闪烁（对齐字母视觉主体，非整行高） */
  .hero-caret {
    display: inline-block;
    width: 0.09em;
    height: 0.72em;
    margin-left: 0.12em;
    background: #18181b; /* 与 logo 文字同色，方正无圆角 */
    /* 贴合小写字母主体：顶对齐后向下压，视觉居中 */
    transform: translateY(0.14em);
    animation: caret-blink 1.1s steps(2, start) infinite;
  }
  @keyframes caret-blink {
    0%, 49% {
      opacity: 1;
    }
    50%, 100% {
      opacity: 0;
    }
  }
  .hero-tagline {
    font-size: 1.25rem;
    color: var(--fg-muted);
    max-width: 36em;
    margin: 0 auto;
    /* 悬浮：亮紫光晕 + 深紫投影（同色相暗影，立体不显灰） */
    text-shadow:
      0 0 10px rgba(196, 181, 253, 0.35),
      0 2px 5px rgba(91, 60, 170, 0.25),
      0 8px 20px rgba(91, 60, 170, 0.2);
  }

  /* 技术署名：working with DeepSeek，位于副标题下方 */
  .hero-working {
    margin-top: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.85rem;
    color: var(--fg-muted, #71717a);
    letter-spacing: 0.02em;
    /* 署名整体景深：轻微投影浮起 */
    filter: drop-shadow(0 1px 1px rgba(120, 113, 108, 0.35))
      drop-shadow(0 2px 6px rgba(60, 50, 45, 0.15));
  }
  /* DeepSeek 图标：放大至与文字字形视觉等高（viewBox 内图形只占约 74% 高度） */
  .hero-ds-logo {
    width: 1.28em;
    height: 1.28em;
    flex: none;
    /* SVG 图标：drop-shadow 才有景深（text-shadow 对 SVG 无效） */
    filter: drop-shadow(0 1px 1px rgba(77, 107, 254, 0.35))
      drop-shadow(0 3px 8px rgba(77, 107, 254, 0.3));
  }
  /* DeepSeek 文字 logo：与图标同色；高度补偿 viewBox 内字形留白，translateY 微调视觉中心对齐 */
  .hero-ds-text {
    height: 1.17em;
    width: auto;
    flex: none;
    color: #4d6bfe;
    /* viewBox 字形偏上，下移补偿（约 1.4px @ 12.8px 字号） */
    transform: translateY(0.11em);
    /* 文字 logo：drop-shadow 蓝色光晕，与图标呼应 */
    filter: drop-shadow(0 1px 1px rgba(77, 107, 254, 0.3))
      drop-shadow(0 3px 8px rgba(77, 107, 254, 0.22));
  }

  /* 药丸导航：紫色渐变主按钮 */
  .hero-pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    /* 1.5px 细边框：默认与内部渐变完全一致（视觉无缝） */
    border: 1.5px solid transparent;
    background:
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) padding-box,
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) border-box;
    padding: calc(0.6em - 1.5px) calc(1.8em - 1.5px); /* 减去边框厚度，视觉尺寸不变 */
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    /* 景深：深色投影（暖黑）+ 紫色光晕，双层阴影让按钮明显浮起 */
    box-shadow:
      0 2px 4px rgba(60, 50, 45, 0.2),
      0 8px 20px rgba(60, 50, 45, 0.22),
      0 12px 32px rgba(99, 102, 241, 0.25);
    transition: box-shadow 0.2s ease;
  }
  .hero-pill:hover {
    box-shadow:
      0 3px 6px rgba(60, 50, 45, 0.22),
      0 12px 28px rgba(60, 50, 45, 0.26),
      0 16px 44px rgba(99, 102, 241, 0.32);
    color: #fff;
    text-decoration: none;
  }
  /* hover 时边框变为单束亮弧：窄弧 + 柔和衰减，沿边缘转圈 */
  .hero-pill:hover {
    background:
      linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #a78bfa 100%) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(167, 139, 250, 0.15) 40deg,
        rgba(255, 255, 255, 0.95) 85deg,
        rgba(255, 255, 255, 0.4) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    animation: pill-sweep 2s linear infinite;
  }
  @property --angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  @keyframes pill-sweep {
    to {
      --angle: 360deg;
    }
  }
  /* "关于"按钮：纯白底（用白色渐变表达，避免压缩器丢失纯色），与紫色渐变区分 */
  .hero-pill-about {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      linear-gradient(#ffffff, #ffffff) border-box;
    color: var(--fg);
    /* 深色投影：白底需要更明显的阴影才有浮起感 */
    box-shadow:
      0 2px 4px rgba(60, 50, 45, 0.12),
      0 8px 20px rgba(60, 50, 45, 0.14);
  }
  .hero-pill-about:hover {
    background:
      linear-gradient(#ffffff, #ffffff) padding-box,
      conic-gradient(
        from var(--angle),
        transparent 0deg,
        rgba(139, 92, 246, 0.2) 40deg,
        rgba(167, 139, 250, 0.95) 85deg,
        rgba(99, 102, 241, 0.45) 115deg,
        transparent 145deg,
        transparent 360deg
      ) border-box;
    color: var(--accent);
    box-shadow:
      0 3px 6px rgba(60, 50, 45, 0.14),
      0 12px 28px rgba(60, 50, 45, 0.18),
      0 14px 36px rgba(99, 102, 241, 0.22);
    animation: pill-sweep 2s linear infinite;
  }

  /* 渐入动画：延迟递增制造层叠感 */
  .hero-section .animate-in {
    animation-delay: 0s;
  }
  .hero-section .animate-in:nth-of-type(1) {
    animation-delay: 0.1s;
  }
  .hero-section .animate-in:nth-of-type(2) {
    animation-delay: 0.25s;
  }
  .hero-section .animate-in:nth-of-type(3) {
    animation-delay: 0.4s;
  }
  .hero-section .animate-in:nth-of-type(4) {
    animation-delay: 0.55s;
  }

  @media (max-width: 640px) {
    .hero-logo {
      font-size: 2.8rem;
    }
    .hero-tagline {
      font-size: 1.1rem;
    }
  }
</style>
