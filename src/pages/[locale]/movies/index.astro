---
import ListLayout from '../../../layouts/ListLayout.astro';
import MovieList from '../../../components/MovieList.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import { getMovies } from '../../../utils/douban';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const movies = await getMovies();

const PER_PAGE = 50;
const currentPage = 1;
const totalPages = Math.max(1, Math.ceil(movies.length / PER_PAGE));
const pageMovies = movies.slice(0, PER_PAGE);
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={t(locale, 'movies.title')}
  description={t(locale, 'movies.description')}
>
  <MovieList
    movies={pageMovies}
    locale={locale}
    total={movies.length}
    currentPage={currentPage}
    totalPages={totalPages}
    filter="all"
  />
</ListLayout>
