---
import ListLayout from '../../../layouts/ListLayout.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import {
  getMovies,
  statsByYear,
  statsByRating,
  statsByGenre,
  statsByRatingGap,
} from '../../../utils/douban';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const movies = await getMovies();

const byGenre = statsByGenre(movies);
const byYear = statsByYear(movies);
const byRating = statsByRating(movies);
const byRatingGap = statsByRatingGap(movies);

const maxGenre = Math.max(1, ...byGenre.map((d) => d.count));
const maxYear = Math.max(1, ...byYear.map((d) => d.count));
const maxRating = Math.max(1, ...byRating.map((d) => d.count));

// 中文星级标签
const ratingLabel = (rating: number) =>
  locale === 'zh' ? '★'.repeat(rating) : rating + '/5';
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={`${t(locale, 'movies.title')} · ${t(locale, 'movies.stats')}`}
  description={t(locale, 'movies.description')}
>
  <div class="mb-6 flex items-center justify-between">
    <a
      href={`/${locale}/movies/`}
      class="text-sm text-accent hover:underline"
    >
      ← {t(locale, 'movies.backToList')}
    </a>
    <p class="text-sm text-zinc-600">
      {t(locale, 'movies.total')} {movies.length}
    </p>
  </div>

  {
    movies.length > 0 ? (
      <>
        {/* 类型 Top */}
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-bold">{t(locale, 'movies.byGenre')}</h2>
          {byGenre.length > 0 ? (
            <div class="flex flex-wrap gap-2">
              {byGenre.map((d) => (
                <span
                  class="rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-800"
                  title={`${d.genre}: ${d.count}`}
                >
                  {d.genre} <b class="text-accent">{d.count}</b>
                </span>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>

        {/* 按标记年份 */}
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-bold">{t(locale, 'movies.byYear')}</h2>
          <div class="space-y-3">
            {byYear.map((d) => (
              <div class="flex items-center gap-3">
                <span class="w-14 shrink-0 text-sm tabular-nums text-zinc-600">{d.year}</span>
                <div class="h-5 flex-1">
                  <div
                    class="flex h-full items-center justify-end rounded bg-gradient-to-r from-accent/70 to-accent pr-2 transition-all"
                    style={`width: ${(d.count / maxYear) * 100}%`}
                  >
                    <span class="text-xs font-semibold text-white">{d.count}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* 按评分 */}
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-bold">{t(locale, 'movies.byRating')}</h2>
          {byRating.length > 0 ? (
            <div class="space-y-3">
              {byRating.map((d) => (
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 text-sm text-amber-500">{ratingLabel(d.rating)}</span>
                  <div class="h-5 flex-1">
                    <div
                      class="flex h-full items-center justify-end rounded bg-gradient-to-r from-zinc-400 to-zinc-600 pr-2 transition-all"
                      style={`width: ${(d.count / maxRating) * 100}%`}
                    >
                      <span class="text-xs font-semibold text-white">{d.count}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>

        {/* 并不觉得好的电影 Top 10（仅电影） */}
        <section>
          <h2 class="mb-4 text-lg font-bold">{t(locale, 'movies.byRatingGap')}</h2>
          {byRatingGap.length > 0 ? (
            <div class="space-y-2">
              {byRatingGap.map((d, i) => (
                <div class="flex items-center gap-3">
                  <span class="w-7 shrink-0 text-sm tabular-nums text-zinc-400">{i + 1}</span>
                  <a
                    href={d.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-w-0 flex-1 truncate text-sm text-zinc-800 hover:text-accent hover:underline"
                    title={d.title}
                  >
                    {d.title}
                  </a>
                  <span class="shrink-0 text-sm tabular-nums text-zinc-600">
                    <span class="text-amber-500">{d.myRating}★</span>
                    <span class="mx-1 text-zinc-300">/</span>
                    <span class="text-zinc-500">{d.doubanRating}</span>
                  </span>
                  <span
                    class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold"
                    class:list={[
                      d.gap >= 4
                        ? 'bg-red-100 text-red-600'
                        : d.gap >= 3
                          ? 'bg-amber-100 text-amber-700'
                          : 'bg-zinc-100 text-zinc-500',
                    ]}
                  >
                    {t(locale, 'movies.gap')} {d.gap}
                  </span>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>
      </>
    ) : (
      <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
    )
  }
</ListLayout>
