---
import ListLayout from '../../../layouts/ListLayout.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import {
  getMovies,
  statsByYear,
  statsByRating,
  statsByStatus,
  statsByDirector,
  statsByGenre,
  statsByReleaseYear,
} from '../../../utils/douban';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const movies = await getMovies();

const byYear = statsByYear(movies);
const byRating = statsByRating(movies);
const byStatus = statsByStatus(movies);
const byDirector = statsByDirector(movies);
const byGenre = statsByGenre(movies);
const byReleaseYear = statsByReleaseYear(movies);

const maxYear = Math.max(1, ...byYear.map((d) => d.count));
const maxRating = Math.max(1, ...byRating.map((d) => d.count));
const maxDirector = Math.max(1, ...byDirector.map((d) => d.count));
const maxGenre = Math.max(1, ...byGenre.map((d) => d.count));
const maxReleaseYear = Math.max(1, ...byReleaseYear.map((d) => d.count));

// 中文星级标签
const ratingLabel = (rating: number) =>
  locale === 'zh' ? '★'.repeat(rating) : rating + '/5';
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={`${t(locale, 'movies.title')} · ${t(locale, 'movies.stats')}`}
  description={t(locale, 'movies.description')}
>
  <div class="mb-8">
    <a
      href={`/${locale}/movies/`}
      class="text-sm text-accent transition-colors hover:bg-zinc-100"
    >
      ← {t(locale, 'movies.backToList')}
    </a>
  </div>

  {
    movies.length > 0 ? (
      <>
        {/* 状态分布 */}
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-bold">{t(locale, 'movies.byStatus')}</h2>
          <div class="grid grid-cols-3 gap-4">
            {byStatus.map((s) => (
              <div class="rounded-xl border border-zinc-200 p-4 text-center">
                <p class="text-3xl font-extrabold text-zinc-900">{s.count}</p>
                <p class="mt-1 text-sm text-zinc-500">
                  {locale === 'zh'
                    ? s.status
                    : s.status === '看过'
                      ? 'Watched'
                      : s.status === '在看'
                        ? 'Watching'
                        : 'Wishlist'}
                </p>
              </div>
            ))}
          </div>
        </section>

        {/* 按年份分布 */}
        <section class="mb-10">
          <h2 class="mb-4 text-lg font-bold">
            {t(locale, 'movies.byYear')}
          </h2>
          <div class="space-y-3">
            {byYear.map((d) => (
              <div class="flex items-center gap-3">
                <span class="w-14 shrink-0 text-sm tabular-nums text-zinc-500">
                  {d.year}
                  {locale === 'zh' ? '' : ''}
                </span>
                <div class="h-5 flex-1 overflow-hidden rounded bg-zinc-100">
                  <div
                    class="flex h-full items-center justify-end rounded bg-gradient-to-r from-accent/70 to-accent pr-2 transition-all"
                    style={`width: ${(d.count / maxYear) * 100}%`}
                  >
                    <span class="text-xs font-semibold text-white">{d.count}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        {/* 按评分分布 */}
        <section>
          <h2 class="mb-4 text-lg font-bold">
            {t(locale, 'movies.byRating')}
          </h2>
          {byRating.length > 0 ? (
            <div class="space-y-3">
              {byRating.map((d) => (
                <div class="flex items-center gap-3">
                  <span class="w-16 shrink-0 text-sm text-amber-500">
                    {ratingLabel(d.rating)}
                  </span>
                  <div class="h-5 flex-1 overflow-hidden rounded bg-zinc-100">
                    <div
                      class="flex h-full items-center justify-end rounded bg-gradient-to-r from-zinc-400 to-zinc-600 pr-2 transition-all"
                      style={`width: ${(d.count / maxRating) * 100}%`}
                    >
                      <span class="text-xs font-semibold text-white">{d.count}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>

        {/* 导演 Top */}
        <section class="mt-10">
          <h2 class="mb-4 text-lg font-bold">
            {t(locale, 'movies.byDirector')}
          </h2>
          {byDirector.length > 0 ? (
            <div class="space-y-3">
              {byDirector.map((d) => (
                <div class="flex items-center gap-3">
                  <span class="w-40 shrink-0 truncate text-sm text-zinc-600">
                    {d.director}
                  </span>
                  <div class="h-5 flex-1 overflow-hidden rounded bg-zinc-100">
                    <div
                      class="flex h-full items-center justify-end rounded bg-gradient-to-r from-zinc-500 to-zinc-700 pr-2 transition-all"
                      style={`width: ${(d.count / maxDirector) * 100}%`}
                    >
                      <span class="text-xs font-semibold text-white">{d.count}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>

        {/* 类型 Top */}
        <section class="mt-10">
          <h2 class="mb-4 text-lg font-bold">
            {t(locale, 'movies.byGenre')}
          </h2>
          {byGenre.length > 0 ? (
            <div class="flex flex-wrap gap-2">
              {byGenre.map((d) => (
                <span
                  class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-700"
                  title={`${d.genre}: ${d.count}`}
                >
                  {d.genre} <b class="text-accent">{d.count}</b>
                </span>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>

        {/* 按上映年份分布 */}
        <section class="mt-10">
          <h2 class="mb-4 text-lg font-bold">
            {t(locale, 'movies.byReleaseYear')}
          </h2>
          {byReleaseYear.length > 0 ? (
            <div class="space-y-3">
              {byReleaseYear.map((d) => (
                <div class="flex items-center gap-3">
                  <span class="w-14 shrink-0 text-sm tabular-nums text-zinc-500">
                    {d.year}
                  </span>
                  <div class="h-5 flex-1 overflow-hidden rounded bg-zinc-100">
                    <div
                      class="flex h-full items-center justify-end rounded bg-gradient-to-r from-accent/70 to-accent pr-2 transition-all"
                      style={`width: ${(d.count / maxReleaseYear) * 100}%`}
                    >
                      <span class="text-xs font-semibold text-white">{d.count}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
          )}
        </section>
      </>
    ) : (
      <p class="text-sm text-zinc-500">{t(locale, 'common.noContent')}</p>
    )
  }
</ListLayout>
