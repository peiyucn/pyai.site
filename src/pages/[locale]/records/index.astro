---
import ListLayout from '../../../layouts/ListLayout.astro';
import RecordCard from '../../../components/RecordCard.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import { getRecords } from '../../../utils/content';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const records = await getRecords(locale);

const tagCounts = new Map<string, number>();
for (const r of records) {
  for (const tag of r.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={t(locale, 'records.title')}
  description={t(locale, 'records.description')}
>
  {allTags.length > 0 && (
    <nav class="mb-8 flex flex-wrap items-center gap-1.5" aria-label="tags">
      <button
        type="button"
        data-records-tag=""
        class:list={[
          'record-tag rounded-full border px-2.5 py-1 text-xs transition-colors',
          'border-accent bg-accent font-semibold text-[#2a1a06]',
        ]}
      >
        {t(locale, 'common.allTags')}
      </button>
      {
        allTags.map((tag) => (
          <button
            type="button"
            data-records-tag={tag}
            class:list={[
              'record-tag rounded-full border px-2.5 py-1 text-xs transition-colors',
              'border-white/10 text-zinc-400 hover:bg-white/10 hover:text-zinc-100',
            ]}
          >
            {tag}
          </button>
        ))
      }
    </nav>
  )}

  <div id="records-list">
    {
      records.length > 0 ? (
        records.map((record, i) => (
          <div
            class:list={['record-item', i > 0 ? 'border-t border-white/10' : '']}
            data-record-tags={record.data.tags.join(',')}
          >
            <RecordCard record={record} locale={locale} />
          </div>
        ))
      ) : (
        <p class="text-sm text-zinc-400">{t(locale, 'common.noContent')}</p>
      )
    }
  </div>
</ListLayout>

<script is:inline>
  // 记录页标签筛选：仅顶部标签栏（nav[aria-label="tags"]）参与。
  // 卡片内标签是纯展示（无 data-records-tag），不参与筛选。
  // 立即执行一次（首次加载），并在 astro:page-load 时重新执行（VT 导航后）。
  function initRecordsFilter() {
    const list = document.getElementById('records-list');
    if (!list) return;
    const items = Array.from(list.querySelectorAll('.record-item'));
    const tagBtns = Array.from(document.querySelectorAll('nav[aria-label="tags"] [data-records-tag]'));
    if (!tagBtns.length) return;

    const setActive = (tag) => {
      tagBtns.forEach((b) => {
        const isActive = (b.dataset.recordsTag ?? '') === tag;
        b.className = 'record-tag rounded-full border px-2.5 py-1 text-xs transition-colors' +
          (isActive
            ? ' border-accent bg-accent font-semibold text-[#2a1a06]'
            : ' border-white/10 text-zinc-400 hover:bg-white/10 hover:text-zinc-100');
      });
    };

    const filter = (tag) => {
      items.forEach((el) => {
        const tags = (el.dataset.recordTags ?? '').split(',').filter(Boolean);
        el.style.display = !tag || tags.includes(tag) ? '' : 'none';
      });
      setActive(tag);
    };

    // 事件委托绑定在 window 上（VT 导航不销毁 window，监听永不丢失），
    // 点击时检查目标是否在当前 document 的 tags 栏内。每次 init 都绑（重复无害，filter 幂等）。
    window.addEventListener('click', (e) => {
      const target = e.target;
      if (!target || !target.closest) return;
      const nav = target.closest('nav[aria-label="tags"]');
      if (!nav) return;
      const btn = target.closest('[data-records-tag]');
      if (!btn) return;
      // 用最新的列表数据过滤（每次点击都重新抓，DOM 重建后也正确）
      const listEl = document.getElementById('records-list');
      if (!listEl) return;
      const itemsEl = Array.from(listEl.querySelectorAll('.record-item'));
      const tag = btn.dataset.recordsTag ?? '';
      itemsEl.forEach((el) => {
        const tags = (el.dataset.recordTags ?? '').split(',').filter(Boolean);
        el.style.display = !tag || tags.includes(tag) ? '' : 'none';
      });
      const btns = Array.from(document.querySelectorAll('nav[aria-label="tags"] [data-records-tag]'));
      btns.forEach((b) => {
        const isActive = (b.dataset.recordsTag ?? '') === tag;
        b.className = 'record-tag rounded-full border px-2.5 py-1 text-xs transition-colors' +
          (isActive
            ? ' border-accent bg-accent font-semibold text-[#2a1a06]'
            : ' border-white/10 text-zinc-400 hover:bg-white/10 hover:text-zinc-100');
      });
    });
    // 初始状态：显示全部
    filter('');
  }

  // 多时机执行：直接调用 + DOMContentLoaded + load + VT 导航后。
  // 某些环境（dev HMR / 脚本注入时机）下直接调用可能不生效，轮询兜底。
  function safeInit() {
    try { initRecordsFilter(); } catch (e) { /* 忽略 */ }
  }
  safeInit();
  document.addEventListener('DOMContentLoaded', safeInit);
  window.addEventListener('load', safeInit);
  document.addEventListener('astro:page-load', safeInit);
  // 轮询兜底：确保 2 秒内必然执行一次（脚本注入延迟场景）
  setTimeout(safeInit, 500);
  setTimeout(safeInit, 1500);
</script>