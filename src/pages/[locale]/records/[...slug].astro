---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import type { Locale } from '../../../i18n/ui';
import { findTranslation, stripLocale } from '../../../utils/content';

export async function getStaticPaths() {
  const records = await getCollection('records');
  return records
    .filter((record) => !record.data.draft)
    .map((record) => ({
      params: { locale: record.data.locale, slug: stripLocale(record.id) },
      props: { record },
    }));
}

const { record } = Astro.props as { record: CollectionEntry<'records'> };
const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const translation = await findTranslation(record, otherLocale);
const translationUrl = translation
  ? `/${otherLocale}/records/${stripLocale(translation.id)}/`
  : undefined;

const { Content } = await render(record);
---

<PostLayout
  entry={record}
  locale={locale}
  pathname={pathname}
  translationUrl={translationUrl}
  backHref={`/${locale}/records/`}
>
  <Content />
</PostLayout>