---
import ListLayout from '../../../layouts/ListLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import type { Locale } from '../../../i18n/ui';
import { t } from '../../../i18n/utils';
import { getPosts } from '../../../utils/content';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;
const posts = await getPosts(locale);
---

<ListLayout
  locale={locale}
  pathname={pathname}
  title={t(locale, 'blog.title')}
  description={t(locale, 'blog.description')}
>
  {
    posts.length > 0 ? (
      posts.map((post) => <PostCard post={post} locale={locale} />)
    ) : (
      <p>{t(locale, 'common.noContent')}</p>
    )
  }
</ListLayout>
