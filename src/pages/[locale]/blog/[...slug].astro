---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import type { Locale } from '../../../i18n/ui';
import { findTranslation, stripLocale } from '../../../utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.data.draft)
    .map((post) => ({
      params: { locale: post.data.locale, slug: stripLocale(post.id) },
      props: { post },
    }));
}

const { post } = Astro.props as { post: any };
const { locale } = Astro.params as { locale: Locale };
const pathname = Astro.url.pathname;

const otherLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const translation = await findTranslation(post, otherLocale);
const translationUrl = translation
  ? `/${otherLocale}/blog/${stripLocale(translation.id)}/`
  : undefined;

const { Content } = await render(post);
---

<PostLayout
  entry={post}
  locale={locale}
  pathname={pathname}
  translationUrl={translationUrl}
  backHref={`/${locale}/blog/`}
>
  <Content />
</PostLayout>
