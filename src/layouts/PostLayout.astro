---
import Base from './Base.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { languages } from '../i18n/ui';
import type { Record } from '../utils/content';
import { formatDate } from '../utils/content';

interface Props {
  /** 记录条目（博客 + 笔记统一） */
  entry: Record;
  locale: Locale;
  pathname: string;
  /** 翻译版本的 URL（若有） */
  translationUrl?: string;
  /** 返回列表页地址 */
  backHref: string;
}

const { entry, locale, pathname, translationUrl, backHref } = Astro.props;
const { data } = entry;

// 翻译链接文案
const translationLabel =
  locale === 'zh'
    ? `Read in English`
    : `阅读中文版本`;

const backLabel = locale === 'zh' ? '← 返回列表' : '← Back to list';
---

<Base title={data.title} description={data.description} locale={locale} pathname={pathname}>
  <article class="mx-auto max-w-3xl px-5 pb-8 pt-14 animate-in">
    <header class="mb-10">
      <a href={backHref} class="text-sm text-accent hover:underline">
        {backLabel}
      </a>
      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
        {data.title}
      </h1>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-zinc-600">
        <time datetime={data.date.toISOString()}>
          {t(locale, 'common.publishedAt')}：{formatDate(data.date, locale)}
        </time>
        {
          data.updated && (
            <time datetime={data.updated.toISOString()}>
              {t(locale, 'common.updatedAt')}：{formatDate(data.updated, locale)}
            </time>
          )
        }
      </div>
      {
        data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )
      }
      {
        translationUrl && (
          <p class="mt-5 text-sm">
            <a
              href={translationUrl}
              class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline"
            >
              <svg
                class="size-3.5"
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18z" />
              </svg>
              {translationLabel}
            </a>
          </p>
        )
      }
    </header>

    <div class="prose max-w-none">
      <slot />
    </div>

    <footer class="mt-14 border-t border-zinc-300 pt-8">
      <a href={backHref} class="text-sm text-accent hover:underline">
        {backLabel}
      </a>
    </footer>
  </article>
</Base>
