---
import Base from './Base.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import { languages } from '../i18n/ui';
import type { Post, Note } from '../utils/content';
import { formatDate } from '../utils/content';

interface Props {
  /** 文章或笔记条目 */
  entry: Post | Note;
  locale: Locale;
  pathname: string;
  /** 翻译版本的 URL（若有） */
  translationUrl?: string;
  /** 返回列表页地址 */
  backHref: string;
}

const { entry, locale, pathname, translationUrl, backHref } = Astro.props;
const { data } = entry;

// 翻译链接文案
const translationLabel =
  locale === 'zh'
    ? `Read in English`
    : `阅读中文版本`;

const backLabel = locale === 'zh' ? '← 返回列表' : '← Back to list';
---

<Base title={data.title} description={data.description} locale={locale} pathname={pathname}>
  <article class="container post-page">
    <header class="post-header">
      <a href={backHref} class="post-back">{backLabel}</a>
      <h1>{data.title}</h1>
      <div class="post-meta">
        <time datetime={data.date.toISOString()}>
          {t(locale, 'common.publishedAt')}：{formatDate(data.date, locale)}
        </time>
        {
          data.updated && (
            <time datetime={data.updated.toISOString()} class="post-updated">
              {t(locale, 'common.updatedAt')}：{formatDate(data.updated, locale)}
            </time>
          )
        }
      </div>
      {
        data.tags.length > 0 && (
          <div class="post-tags">
            {data.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )
      }
      {
        translationUrl && (
          <p class="post-translation">
            <a href={translationUrl}>🌐 {translationLabel}</a>
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post-footer">
      <a href={backHref} class="btn">{backLabel}</a>
    </footer>
  </article>
</Base>

<style>
  .post-page {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }
  .post-header {
    margin-bottom: 2.5rem;
  }
  .post-back {
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
  .post-back:hover {
    color: var(--accent);
  }
  .post-header h1 {
    margin: 0.6em 0 0.4em;
    font-size: 2.1rem;
    line-height: 1.3;
  }
  .post-meta {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .post-tags {
    margin-top: 1rem;
  }
  .post-translation {
    margin: 1.2rem 0 0;
    font-size: 0.95rem;
  }
  .post-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
