---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorAtom from '../components/CursorAtom.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  /** 页面标题（不含站点名） */
  title: string;
  /** 页面描述，用于 meta description */
  description?: string;
  /** 当前语言 */
  locale: Locale;
  /** 当前路径（用于导航高亮与语言切换） */
  pathname: string;
  /** 是否隐藏顶部导航栏（首页用：导航以药丸形式放在内容区） */
  hideHeader?: boolean;
  /** 是否隐藏页脚（首页全屏 Hero 用） */
  hideFooter?: boolean;
}

const {
  title,
  description,
  locale,
  pathname,
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const siteTitle = 'pyai.site';
const fullTitle = title === siteTitle ? siteTitle : `${title} · ${siteTitle}`;

// Open Graph 基础信息
const og = {
  locale: locale === 'zh' ? 'zh_CN' : 'en_US',
  type: 'website',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? ''} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? ''} />
    <meta property="og:type" content={og.type} />
    <meta property="og:locale" content={og.locale} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />

    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <!-- 主题色 -->
    <meta name="theme-color" content="#4f46e5" />

    <!-- Favicon（内联 SVG） -->
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='90'%3E%F0%9F%90%88%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body>
    {!hideHeader && <Header locale={locale} pathname={pathname} />}
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer locale={locale} />}
    {/* 原子风格自定义鼠标光标（触屏自动禁用） */}
    <CursorAtom />
  </body>
</html>
