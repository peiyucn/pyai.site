---
import Base from './Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
  description: string;
  /** 可选：额外的说明文字（如观影页的最近同步时间） */
  syncNote?: string;
}

const { locale, pathname, title, description, syncNote } = Astro.props;
---

<Base title={title} description={description} locale={locale} pathname={pathname}>
  <div class="mx-auto max-w-3xl px-5 pb-8 pt-14 animate-in">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight text-zinc-50">{title}</h1>
      {description && <p class="mt-2 text-base text-zinc-400">{description}</p>}
      {syncNote && <p class="mt-1 text-sm text-zinc-500">{syncNote}</p>}
    </header>
    <slot />
  </div>
</Base>
