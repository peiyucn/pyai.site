---
import Base from './Base.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
  description: string;
}

const { locale, pathname, title, description } = Astro.props;
---

<Base title={title} description={description} locale={locale} pathname={pathname}>
  <div class="mx-auto max-w-3xl px-5 pb-8 pt-14 animate-in">
    <header class="mb-8">
      <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
      {description && <p class="mt-2 text-base text-zinc-600">{description}</p>}
    </header>
    <slot />
  </div>
</Base>
