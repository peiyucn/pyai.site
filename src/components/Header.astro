---
import type { Locale, UIKey } from '../i18n/ui';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import GitHubLink from './GitHubLink.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const navItems: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];

/** 当前 section 高亮：根路径精确匹配，其余按前缀匹配 */
function isActive(href: string): boolean {
  if (href === `/${locale}/`) {
    return pathname === href;
  }
  return pathname.startsWith(href);
}
---

<header
  class="site-header sticky top-0 z-[60] border-b border-white/10"
>
  <div class="mx-auto flex h-14 max-w-3xl items-center gap-6 px-5">
    <a
      href={`/${locale}/`}
      data-astro-reload
      class="header-logo whitespace-nowrap text-lg font-bold tracking-tight text-zinc-50 hover:no-underline"
      aria-label="pyai.site"
    >
      pyai<span class="text-gradient">.site</span>
    </a>
    <nav class="flex flex-1 gap-1 overflow-x-auto" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-item whitespace-nowrap rounded-md px-2.5 py-1 text-sm transition-colors hover:no-underline',
              isActive(item.href) ? 'nav-item-active' : '',
            ]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2">
      <GitHubLink />
      <LanguageSwitcher locale={locale} pathname={pathname} dark />
    </div>
  </div>
</header>

<style>
  /* 深色标题栏背景：近黑毛玻璃，金色描边在边框（border-white/10）基础上由下方 active 高亮补足 */
  .site-header {
    background: linear-gradient(
      115deg,
      rgba(10, 10, 16, 0.8) 0%,
      rgba(18, 15, 26, 0.74) 45%,
      rgba(12, 11, 18, 0.78) 100%
    );
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* 深色标题栏上的 .site 渐变：金色渐变，呼应首页月食金 */
  .header-logo .text-gradient {
    background-image: linear-gradient(
      135deg,
      #e8a24a 0%,
      #f0b95e 50%,
      #ffd48a 100%
    );
  }

  /* 导航项基础：未选中为浅灰文字，hover 半透明白底 */
  .nav-item {
    color: #d4d4d8; /* zinc-300 */
  }
  .nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* 选中态：金色文字 + 淡金底 + 中等字重 */
  .nav-item-active,
  .nav-item-active:hover {
    color: #ffd48a;
    font-weight: 600;
    background: rgba(232, 162, 74, 0.14);
  }
  .nav-item-active:hover {
    background: rgba(232, 162, 74, 0.22);
  }
</style>
