---
import type { Locale, UIKey } from '../i18n/ui';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const navItems: { key: UIKey; href: string }[] = [
  { key: 'nav.home', href: `/${locale}/` },
  { key: 'nav.blog', href: `/${locale}/blog/` },
  { key: 'nav.notes', href: `/${locale}/notes/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];

/** 当前 section 高亮：根路径精确匹配，其余按前缀匹配 */
function isActive(href: string): boolean {
  if (href === `/${locale}/`) {
    return pathname === href;
  }
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={`/${locale}/`} aria-label="pyai.site">pyai.site</a>
    <nav class="nav" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} pathname={pathname} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 3.5rem;
  }
  .logo {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--fg);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .logo:hover {
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 0.25rem;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    color: var(--fg-muted);
    font-size: 0.95rem;
    padding: 0.3em 0.7em;
    border-radius: 6px;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--fg);
    background: var(--accent-soft);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .header-inner {
      gap: 0.75rem;
    }
  }
</style>
