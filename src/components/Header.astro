---
import type { Locale, UIKey } from '../i18n/ui';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const navItems: { key: UIKey; href: string }[] = [
  { key: 'nav.home', href: `/${locale}/` },
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];

/** 当前 section 高亮：根路径精确匹配，其余按前缀匹配 */
function isActive(href: string): boolean {
  if (href === `/${locale}/`) {
    return pathname === href;
  }
  return pathname.startsWith(href);
}
---

<header
  class="sticky top-0 z-10 border-b border-purple-200/70 backdrop-blur-lg bg-[linear-gradient(115deg,rgba(237,233,254,0.75)_0%,rgba(224,231,255,0.55)_40%,rgba(243,232,255,0.75)_75%,rgba(224,231,255,0.6)_100%)]"
>
  <div class="mx-auto flex h-14 max-w-3xl items-center gap-6 px-5">
    <a
      href={`/${locale}/`}
      class="whitespace-nowrap text-lg font-bold tracking-tight text-zinc-900 hover:no-underline"
      aria-label="pyai.site"
    >
      pyai<span class="text-gradient">.site</span>
    </a>
    <nav class="flex flex-1 gap-1 overflow-x-auto" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap rounded-md px-2.5 py-1 text-sm text-zinc-600 transition-colors hover:no-underline',
              isActive(item.href)
                ? 'font-semibold text-accent'
                : 'hover:bg-purple-100/80 hover:text-purple-900',
            ]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} pathname={pathname} />
  </div>
</header>
