---
import type { Locale, UIKey } from '../i18n/ui';
import { t } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const navItems: { key: UIKey; href: string }[] = [
  { key: 'nav.records', href: `/${locale}/records/` },
  { key: 'nav.projects', href: `/${locale}/projects/` },
  { key: 'nav.movies', href: `/${locale}/movies/` },
  { key: 'nav.about', href: `/${locale}/about/` },
];

/** 当前 section 高亮：根路径精确匹配，其余按前缀匹配 */
function isActive(href: string): boolean {
  if (href === `/${locale}/`) {
    return pathname === href;
  }
  return pathname.startsWith(href);
}
---

<header
  class="site-header sticky top-0 z-[60] border-b border-purple-300/20"
>
  <div class="mx-auto flex h-14 max-w-3xl items-center gap-6 px-5">
    <a
      href={`/${locale}/`}
      data-astro-reload
      class="header-logo whitespace-nowrap text-lg font-bold tracking-tight text-zinc-50 hover:no-underline"
      aria-label="pyai.site"
    >
      pyai<span class="text-gradient">.site</span>
    </a>
    <nav class="flex flex-1 gap-1 overflow-x-auto" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'nav-item whitespace-nowrap rounded-md px-2.5 py-1 text-sm transition-colors hover:no-underline',
              isActive(item.href) ? 'nav-item-active' : '',
            ]}
          >
            {t(locale, item.key)}
          </a>
        ))
      }
    </nav>
    <LanguageSwitcher locale={locale} pathname={pathname} dark />
  </div>
</header>

<style>
  /* 深色标题栏背景：毛玻璃（纯净深紫，不透明度稍高避免与浅色页面混合显脏）
     （arbitrary class bg-[linear-gradient(...)] 在 Tailwind 4 下编译失败导致背景透明） */
  .site-header {
    background: linear-gradient(
      115deg,
      rgba(24, 20, 60, 0.86) 0%,
      rgba(37, 30, 82, 0.82) 40%,
      rgba(58, 30, 96, 0.84) 75%,
      rgba(24, 20, 60, 0.82) 100%
    );
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  /* 深色标题栏上的 .site 渐变：亮紫渐变，深色毛玻璃上清晰可见 */
  .header-logo .text-gradient {
    background-image: linear-gradient(
      135deg,
      #a5b4fc 0%,
      #c4b5fd 50%,
      #e9d5ff 100%
    );
  }

  /* 导航项基础：未选中为浅灰文字，hover 半透明白底 */
  .nav-item {
    color: #d4d4d8; /* zinc-300 */
  }
  .nav-item:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* 选中态：亮紫文字 + 淡紫底 + 中等字重 */
  .nav-item-active,
  .nav-item-active:hover {
    color: #c4b5fd;
    font-weight: 600;
    background: rgba(196, 181, 253, 0.15);
  }
  .nav-item-active:hover {
    background: rgba(196, 181, 253, 0.25);
  }
</style>
