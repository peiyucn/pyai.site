---
import type { Locale } from '../i18n/ui';
import type { Project } from '../utils/content';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const statusText: Record<string, { label: string; class: string }> = {
  active: { label: locale === 'zh' ? '维护中' : 'Active', class: 'status-active' },
  wip: { label: locale === 'zh' ? '开发中' : 'WIP', class: 'status-wip' },
  archived: { label: locale === 'zh' ? '已归档' : 'Archived', class: 'status-archived' },
};
const status = statusText[project.data.status];
---

<article
  class:list={[
    'group flex flex-col gap-2.5 rounded-xl border border-white/10 bg-white/5 p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-accent hover:shadow-md',
    project.data.status === 'archived' && 'project-archived',
  ]}
>
  <div class="flex items-center justify-between gap-3">
    <h2
      class="text-lg font-bold text-zinc-50 group-hover:text-accent"
    >
      {project.data.title}
    </h2>
    <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', status.class]}>
      {status.label}
    </span>
  </div>
  <p class="flex-1 text-sm leading-relaxed text-zinc-400">
    {project.data.description}
  </p>
  <div class="flex gap-4 text-sm font-medium">
    {
      project.data.repo && (
        <a
          href={project.data.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline"
        >
          <span aria-hidden="true">⤴</span> GitHub
        </a>
      )
    }
    {
      project.data.link && (
        <a
          href={project.data.link}
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent hover:underline"
        >
          <span aria-hidden="true">↗</span> {locale === 'zh' ? '链接' : 'Link'}
        </a>
      )
    }
  </div>
</article>
