---
// 粒子网络背景组件（Canvas + 鼠标互动）
// 纯原生实现，无第三方依赖；variant: light(浅色 indigo) | dark(深色金星星点)
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<div class="particle-bg" data-variant={variant} aria-hidden="true">
  <canvas id="particle-canvas"></canvas>
</div>

<script>
  // 粒子网络动画：光点 + 连线 + 鼠标吸引
  // 顶层执行（Astro 脚本在 body 末尾，DOM 已就绪）+ DOMContentLoaded 兜底
  function startParticleBg() {
    const canvas = document.getElementById('particle-canvas');
    if (!canvas || canvas.dataset.started) return;
    canvas.dataset.started = '1';
    const ctx = canvas.getContext('2d');

    // 性能与数量配置（移动端减少粒子数）
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const PARTICLE_COUNT = isMobile ? 28 : 50;
    const MAX_DISTANCE = 110;
    const MOUSE_RADIUS = 140;
    // 黑洞（吸积盘）参数：粒子默认被慢慢吸向中心；
    // 鼠标靠近黑洞吸入加速、远离减速；
    // 粒子进入黑洞视觉圆（光弧环半径）即渐隐，到中心附近被"吃掉"重生到边缘
    const BASE_PULL = 0.02;
    // 黑洞环视觉半径 ≈ 光弧 scale 0.60 的环半径（UV 0.30 × 视口短边）
    const BH_VISUAL_R = 0.27;
    const BH_RADIUS = 0.08; // 重生半径（视口短边比例）
    const FADE_RANGE = 0.35; // 渐隐起始半径（视口短边比例，提前淡，进入黑洞圆前已半透明）

    const variant = canvas.closest('.particle-bg')?.dataset.variant || 'light';
    const COLORS = {
      light: { particle: '99, 102, 241', line: '99, 102, 241' }, // indigo-500
      dark: { particle: '237, 237, 237', line: '237, 237, 237' }, // 灰白 #EDEDED，星点氛围（光弧保持金色）
    };

    // 星河光晕（仅 dark 变体）：纯黑背景上几团柔和径向光晕，缓慢漂移 + 呼吸，
    // 营造"星河/星云"氛围。灰白为主（呼应星点），少量淡金色（呼应黑洞金色光弧）。
    const BLOBS = [
      { x: 0.28, y: 0.30, r: 0.34, color: '237, 237, 237', alpha: 0.055, sx: 0.10, sy: 0.07, fx: 0.05, fy: 0.043, phase: 0.0, pulse: 0.25 },
      { x: 0.72, y: 0.25, r: 0.26, color: '255, 212, 138', alpha: 0.045, sx: 0.08, sy: 0.06, fx: 0.037, fy: 0.05,  phase: 2.1, pulse: 0.3 },
      { x: 0.78, y: 0.68, r: 0.30, color: '237, 237, 237', alpha: 0.05,  sx: 0.09, sy: 0.08, fx: 0.043, fy: 0.036, phase: 4.2, pulse: 0.22 },
      { x: 0.22, y: 0.72, r: 0.22, color: '255, 212, 138', alpha: 0.04,  sx: 0.07, sy: 0.06, fx: 0.055, fy: 0.047, phase: 1.4, pulse: 0.35 },
      { x: 0.50, y: 0.88, r: 0.20, color: '237, 237, 237', alpha: 0.04,  sx: 0.10, sy: 0.05, fx: 0.032, fy: 0.06,  phase: 3.3, pulse: 0.28 },
    ];
    let blobs = [];

    function initBlobs() {
      // 移动端减少光晕团（性能）；位置/半径沿用配置，每次 resize 重新生成随机相位
      const count = isMobile ? 3 : BLOBS.length;
      blobs = BLOBS.slice(0, count).map((b) => ({
        ...b,
        phase: b.phase + Math.random() * Math.PI * 2,
      }));
    }

    // ===== 星云噪点纹理（预生成一次）=====
    // 真实星河的质感 = 深浅不一的斑驳明暗 + 高噪点的尘埃颗粒。
    // 用 value noise 的 fBm：低频 octave 形成大块云状明暗，中高频 octave 叠加尘埃颗粒。
    // 纹理固定 512×512，运行时按像素坐标哈希伪随机（GLSL 风格），确定性、无重复纹理感。
    let nebulaTex = null;
    function makeNoiseTex(size) {
      const c = document.createElement('canvas');
      c.width = c.height = size;
      const g = c.getContext('2d');
      const img = g.createImageData(size, size);
      const d = img.data;
      // 哈希伪随机：同 (x,y) 永远同值，保证纹理稳定（不闪烁）
      const h = (x, y) => {
        const s = Math.sin(x * 127.1 + y * 311.7) * 43758.5453123;
        return s - Math.floor(s);
      };
      // value noise（单 octave，双线性平滑插值）
      const vnoise = (x, y) => {
        const xi = Math.floor(x), yi = Math.floor(y);
        const xf = x - xi, yf = y - yi;
        const u = xf * xf * (3 - 2 * xf);
        const v = yf * yf * (3 - 2 * yf);
        const a = h(xi, yi), b = h(xi + 1, yi);
        const c2 = h(xi, yi + 1), d2 = h(xi + 1, yi + 1);
        return a + (b - a) * u + (c2 - a) * v + (a - b - c2 + d2) * u * v;
      };
      // fBm：多 octave 叠加（低频大云 → 高频颗粒）
      const fbm = (x, y, oct) => {
        let sum = 0, amp = 0.5, freq = 1, norm = 0;
        for (let i = 0; i < oct; i++) {
          sum += amp * vnoise(x * freq, y * freq);
          norm += amp;
          amp *= 0.5;
          freq *= 2;
        }
        return sum / norm;
      };
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          // 大块云（低频）+ 尘埃颗粒（中高频）：深浅不一的星云明暗
          const cloud = fbm(x / 11, y / 11, 3);
          const grain = fbm(x / 3.2 + 40.7, y / 3.2 + 89.3, 2);
          let v = cloud * 0.82 + grain * 0.18;
          // 非对称映射：大部分区域暗、少量亮斑凸出（星云"深浅不一"）
          v = Math.pow(Math.max(0, Math.min(1, v)), 1.7);
          const i = (y * size + x) * 4;
          // 冷白偏灰蓝（呼应星点，避免纯白刺眼）
          d[i] = 238; d[i + 1] = 240; d[i + 2] = 246;
          d[i + 3] = Math.round(v * 255 * 0.85);
        }
      }
      g.putImageData(img, 0, 0);
      return c;
    }
    function initNebula() {
      if (variant === 'dark' && !nebulaTex) nebulaTex = makeNoiseTex(768);
    }

    // 绘制星云噪点底：平铺 + 极缓慢漂移（星云流动感）
    function drawNebula() {
      if (variant !== 'dark' || !nebulaTex) return;
      const S = 768;
      const t = performance.now() / 1000;
      const ox = (t * 6) % S; // 6px/s 缓慢横向流动
      const oy = (t * 4) % S; // 4px/s 纵向
      const cols = Math.ceil(width / S) + 1;
      const rows = Math.ceil(height / S) + 1;
      ctx.save();
      ctx.globalAlpha = 0.38; // 整体克制，不抢黑洞/文字主体
      ctx.imageSmoothingEnabled = true; // 平滑缩放，柔化颗粒边缘（细腻星云）
      ctx.imageSmoothingQuality = 'high';
      for (let dx = 0; dx < cols; dx++) {
        for (let dy = 0; dy < rows; dy++) {
          ctx.drawImage(nebulaTex, dx * S - ox, dy * S - oy, S, S);
        }
      }
      ctx.restore();
    }

    // 黑洞"吞没"星云：黑洞是透明的（下方 WebGL 的金色环 + pyai.site 文字要靠它透出来），
    // 所以背景（星云+光晕）要往中心"汇聚消失"——以黑洞圆心为中心用 destination-out
    // 挖一个径向渐变洞：中心完全挖空 → 边缘柔和过渡到完整星云。
    // 这样视觉上：星云从四面八方流进黑洞被吞噬，黑洞区域干净露出金色环+文字。
    // 挖洞圆心跟随 window.__pyaiBH（WebGL beam hook 每帧写入的黑洞归一化坐标）。
    function drawBlackHoleMask() {
      if (variant !== 'dark') return;
      const bh = window.__pyaiBH;
      const bhx = width * (bh ? bh.x : 0.5);
      const bhy = height * (bh ? 1 - bh.y : 0.5);
      // 挖洞半径略大于视觉环（BH_VISUAL_R），让星云在接近黑洞时柔和被吞
      const bhR = Math.min(width, height) * BH_VISUAL_R * 1.3;
      if (bhR <= 0) return;
      ctx.save();
      ctx.globalCompositeOperation = 'destination-out';
      const g = ctx.createRadialGradient(bhx, bhy, 0, bhx, bhy, bhR);
      g.addColorStop(0, 'rgba(0,0,0,1)');
      g.addColorStop(0.55, 'rgba(0,0,0,0.85)');
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(bhx, bhy, bhR, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    // 绘制星河光晕：径向渐变团，缓慢漂移（sin/cos 组合）+ 呼吸（alpha 脉动）
    function drawBlobs() {
      if (variant !== 'dark') return;
      const t = performance.now() / 1000;
      const short = Math.min(width, height);
      for (const b of blobs) {
        // 缓慢漂移：两个不同频率的正弦组合，永不重复
        const bx = b.x * width + Math.sin(t * b.fx + b.phase) * b.sx * width;
        const by = b.y * height + Math.cos(t * b.fy + b.phase * 1.3) * b.sy * height;
        // 呼吸：alpha 慢速脉动
        const a = b.alpha * (1 + b.pulse * Math.sin(t * 0.09 + b.phase * 2));
        const r = b.r * short;
        if (a <= 0.002) continue;
        const g = ctx.createRadialGradient(bx, by, 0, bx, by, r);
        g.addColorStop(0, `rgba(${b.color}, ${a.toFixed(4)})`);
        g.addColorStop(0.45, `rgba(${b.color}, ${(a * 0.45).toFixed(4)})`);
        g.addColorStop(1, `rgba(${b.color}, 0)`);
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(bx, by, r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    let particles = [];
    let mouse = { x: null, y: null };
    let width = 0, height = 0, dpr = 1;
    let rafId = null;
    let fallbackTimer = null;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const parent = canvas.parentElement;
      width = parent.clientWidth || window.innerWidth || 800;
      height = parent.clientHeight || window.innerHeight || 600;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initNebula();
      initBlobs();
      initParticles();
    }

    function initParticles() {
      particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        size: Math.random() * 1.3 + 0.5,
      }));
    }

    // 粒子被黑洞吃掉后，重生到画布边缘（形成持续吸入流）
    function respawnAtEdge(p) {
      const edge = Math.floor(Math.random() * 4);
      const m = 24;
      if (edge === 0) { p.x = Math.random() * width; p.y = m; }
      else if (edge === 1) { p.x = Math.random() * width; p.y = height - m; }
      else if (edge === 2) { p.x = m; p.y = Math.random() * height; }
      else { p.x = width - m; p.y = Math.random() * height; }
      p.vx = (Math.random() - 0.5) * 0.4;
      p.vy = (Math.random() - 0.5) * 0.4;
    }

    function draw() {
      if (width === 0 || height === 0) return;
      ctx.clearRect(0, 0, width, height);
      // 星云噪点底（深浅不一的云状明暗 + 尘埃颗粒）→ 亮斑光晕 → 黑洞挖洞 → 粒子
      drawNebula();
      drawBlobs();
      drawBlackHoleMask(); // 星云/光晕在黑洞中心被吞没，露出下方 WebGL 黑洞环+文字
      const color = COLORS[variant] || COLORS.light;
      // 黑洞圆心（像素）：跟随 WebGL 黑洞（MoonshotHero beam hook 每帧写入的归一化 UV 坐标，
      // x 右=+、y 上=+）。粒子被吞/渐隐的"隐藏区域"必须与黑洞精确同步，
      // 否则鼠标移动时黑洞移走、粒子隐藏区却留在原地（bug 根因）。
      // 未就绪（WebGL 场景还没创建 / 无 hero 页面）时回退到画布中心。
      const bh = window.__pyaiBH;
      const bhx = width * (bh ? bh.x : 0.5);
      const bhy = height * (bh ? 1 - bh.y : 0.5); // UV y 向上为正 → 画布 y 向下为正
      // 黑洞视觉半径（像素）：基于视口短边
      const bhVisual = Math.min(width, height) * BH_VISUAL_R;
      const bhCore = Math.min(width, height) * BH_RADIUS;
      const fadeStart = Math.min(width, height) * FADE_RANGE;

      // 鼠标离黑洞的归一化距离 → 吸入速度系数（近快、远慢）
      let pullFactor = 1.0;
      if (mouse.x !== null) {
        const mdx = mouse.x - bhx, mdy = mouse.y - bhy;
        const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
        const maxD = Math.sqrt(bhx * bhx + bhy * bhy) || 1;
        pullFactor = 0.4 + 1.4 * (1 - Math.min(1, mdist / maxD));
      }

      for (const p of particles) {
        // 引力向黑洞（吸积盘吸入）
        const dx = bhx - p.x, dy = bhy - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        p.vx += (dx / dist) * BASE_PULL * pullFactor;
        p.vy += (dy / dist) * BASE_PULL * pullFactor;
        p.vx *= 0.99;
        p.vy *= 0.99;
        p.x += p.vx;
        p.y += p.vy;

        // 鼠标扰动：鼠标附近粒子轻微绕开（保留原互动，力度降低避免抖动）
        if (mouse.x !== null) {
          const mdx = mouse.x - p.x, mdy = mouse.y - p.y;
          const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
          if (mdist < MOUSE_RADIUS && mdist > 0.01) {
            const force = (MOUSE_RADIUS - mdist) / MOUSE_RADIUS;
            p.vx -= (mdx / mdist) * force * 0.25;
            p.vy -= (mdy / mdist) * force * 0.25;
          }
        }

        // 被黑洞吃掉（进入黑洞视觉圆边缘 0.9×fadeStart）→ 重生到边缘。
        // 用视觉圆作为吞没线（而非中心核），粒子"进入黑洞"即消失，圆内几乎无粒子
        if (dist < fadeStart * 0.9) {
          respawnAtEdge(p);
          continue;
        }

        // 靠近黑洞视觉圆渐隐：进入 fadeStart 内逐渐变淡，越靠近中心越透明
        let alpha = 0.7;
        if (dist < fadeStart) {
          alpha = 0.7 * Math.max(0, (dist - bhCore) / (fadeStart - bhCore));
        }
        if (alpha <= 0.02) continue; // 完全透明就不画，避免"幽灵"粒子

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color.particle}, ${alpha})`;
        ctx.fill();
      }

      // 连线：黑洞内（被渐隐）的粒子不参与连线，避免"圆内还有线"的残留感
      const visibleParticles = particles.filter((p) => {
        const d = Math.sqrt((bhx - p.x) ** 2 + (bhy - p.y) ** 2);
        return d >= fadeStart * 0.85; // 渐隐区内的粒子不连线
      });
      for (let i = 0; i < visibleParticles.length; i++) {
        for (let j = i + 1; j < visibleParticles.length; j++) {
          const a = visibleParticles[i];
          const b = visibleParticles[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DISTANCE) {
            const opacity = (1 - dist / MAX_DISTANCE) * 0.10;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = `rgba(${color.line}, ${opacity})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }
    }

    function onMouseMove(e) {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }

    function onMouseLeave() {
      mouse.x = null;
      mouse.y = null;
    }

    let lastTime = 0;
    const FPS = 30;
    const loop = () => {
      draw();
      rafId = requestAnimationFrame(loop);
    };

    function start() {
      resize();
      if (width === 0 || height === 0) {
        setTimeout(start, 100);
        return;
      }
      draw();
      try {
        rafId = requestAnimationFrame(loop);
      } catch {
        /* rAF 不可用时回退 */
      }
      fallbackTimer = setInterval(() => {
        const now = Date.now();
        if (now - lastTime > 1000 / FPS) {
          lastTime = now;
          draw();
        }
      }, 1000 / FPS);

      window.addEventListener('resize', resize);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseleave', onMouseLeave);

      // 把本次动画的清理逻辑登记到模块级数组，由唯一的 before-swap 监听器统一执行
      cleanupFns.push(() => {
        cancelAnimationFrame(rafId);
        if (fallbackTimer) clearInterval(fallbackTimer);
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseleave', onMouseLeave);
      });
    }

    start();
  }

  // 模块级清理登记表 + 唯一的 before-swap 监听器（跨导航持久，避免切换多次后监听器堆积）
  const cleanupFns = [];
  document.addEventListener('astro:before-swap', () => {
    for (const fn of cleanupFns) fn();
    cleanupFns.length = 0;
  });

  // 立即尝试 + DOMContentLoaded 兜底 + 延迟兜底（兼容各种加载时机）
  startParticleBg();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startParticleBg);
  } else {
    setTimeout(startParticleBg, 0);
  }
  setTimeout(startParticleBg, 200);
  // View Transitions：切换页面（如中英文）时 body 被替换、模块脚本不重跑，
  // 新页面的 canvas 需要在此重启（监听器挂 document，跨导航持久）
  document.addEventListener('astro:page-load', startParticleBg);
</script>

<style>
  .particle-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .particle-bg canvas {
    display: block;
  }
</style>
