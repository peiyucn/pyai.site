---

interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<div class="particle-bg" data-variant={variant} aria-hidden="true">
  <canvas id="particle-canvas"></canvas>
</div>

<script>

  function startParticleBg() {
    const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
    if (!canvas || canvas.dataset.started) return;
    canvas.dataset.started = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const PARTICLE_COUNT = isMobile ? 28 : 50;
    const MOUSE_RADIUS = 140;

    const BASE_PULL = 0.02;

    const BH_RADIUS = 0.08;
    const FADE_RANGE = 0.35;

    const wrap = canvas.closest('.particle-bg') as HTMLElement | null;
    const variant: 'light' | 'dark' = (wrap?.dataset.variant as 'light' | 'dark' | undefined) ?? 'light';
    const COLORS = {
      light: { particle: '99, 102, 241' },
      dark: { particle: '237, 237, 237' },
    };

    interface Particle { x: number; y: number; vx: number; vy: number; size: number }
    let particles: Particle[] = [];
    const mouse: { x: number | null; y: number | null } = { x: null, y: null };
    let width = 0, height = 0, dpr = 1;
    let rafId: number | null = null;
    let fallbackTimer: number | null = null;

    function resize() {
      if (!canvas || !ctx) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const parent = canvas.parentElement;
      if (!parent) return;
      width = parent.clientWidth || window.innerWidth || 800;
      height = parent.clientHeight || window.innerHeight || 600;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initParticles();
    }

    function initParticles() {
      particles = Array.from({ length: PARTICLE_COUNT }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        size: Math.random() * 0.8 + 0.35,
      }));
    }

    function respawnAtEdge(p: Particle) {
      const edge = Math.floor(Math.random() * 4);
      const m = 24;
      if (edge === 0) { p.x = Math.random() * width; p.y = m; }
      else if (edge === 1) { p.x = Math.random() * width; p.y = height - m; }
      else if (edge === 2) { p.x = m; p.y = Math.random() * height; }
      else { p.x = width - m; p.y = Math.random() * height; }
      p.vx = (Math.random() - 0.5) * 0.4;
      p.vy = (Math.random() - 0.5) * 0.4;
    }

    function draw() {
      if (!ctx) return;
      if (width === 0 || height === 0) return;
      ctx.clearRect(0, 0, width, height);
      const color = COLORS[variant] || COLORS.light;

      const bh = window.__pyaiBH;
      const bhx = width * (bh ? bh.x : 0.5);
      const bhy = height * (bh ? 1 - bh.y : 0.5);

      const bhCore = Math.min(width, height) * BH_RADIUS;
      const fadeStart = Math.min(width, height) * FADE_RANGE;

      let pullFactor = 1.0;
      if (mouse.x !== null && mouse.y !== null) {
        const mdx = mouse.x - bhx, mdy = mouse.y - bhy;
        const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
        const maxD = Math.sqrt(bhx * bhx + bhy * bhy) || 1;
        pullFactor = 0.4 + 1.4 * (1 - Math.min(1, mdist / maxD));
      }

      for (const p of particles) {

        const dx = bhx - p.x, dy = bhy - p.y;
        const dist = Math.sqrt(dx * dx + dy * dy) || 1;
        p.vx += (dx / dist) * BASE_PULL * pullFactor;
        p.vy += (dy / dist) * BASE_PULL * pullFactor;
        p.vx *= 0.99;
        p.vy *= 0.99;
        p.x += p.vx;
        p.y += p.vy;

        if (mouse.x !== null && mouse.y !== null) {
          const mdx = mouse.x - p.x, mdy = mouse.y - p.y;
          const mdist = Math.sqrt(mdx * mdx + mdy * mdy);
          if (mdist < MOUSE_RADIUS && mdist > 0.01) {
            const force = (MOUSE_RADIUS - mdist) / MOUSE_RADIUS;
            p.vx -= (mdx / mdist) * force * 0.25;
            p.vy -= (mdy / mdist) * force * 0.25;
          }
        }

        if (dist < fadeStart * 0.9) {
          respawnAtEdge(p);
          continue;
        }

        let alpha = 0.35;
        if (dist < fadeStart) {
          alpha = 0.35 * Math.max(0, (dist - bhCore) / (fadeStart - bhCore));
        }
        if (alpha <= 0.02) continue;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${color.particle}, ${alpha})`;
        ctx.fill();
      }
    }

    function onMouseMove(e: MouseEvent) {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    }

    function onMouseLeave() {
      mouse.x = null;
      mouse.y = null;
    }

    const loop = () => {
      draw();
      rafId = requestAnimationFrame(loop);
    };

    function start() {
      resize();
      if (width === 0 || height === 0) {
        setTimeout(start, 100);
        return;
      }
      draw();
      let rafFailed = false;
      try {
        rafId = requestAnimationFrame(loop);
      } catch {
        rafFailed = true;
      }
      if (rafFailed) {
        fallbackTimer = window.setInterval(draw, 1000 / 30);
      }

      window.addEventListener('resize', resize);
      window.addEventListener('mousemove', onMouseMove);
      window.addEventListener('mouseleave', onMouseLeave);

      cleanupFns.push(() => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        if (fallbackTimer !== null) clearInterval(fallbackTimer);
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', onMouseMove);
        window.removeEventListener('mouseleave', onMouseLeave);
      });
    }

    start();
  }

  const cleanupFns: (() => void)[] = [];
  document.addEventListener('astro:before-swap', () => {
    for (const fn of cleanupFns) fn();
    cleanupFns.length = 0;
  });

  startParticleBg();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startParticleBg);
  } else {
    setTimeout(startParticleBg, 0);
  }
  setTimeout(startParticleBg, 200);

  document.addEventListener('astro:page-load', startParticleBg);
</script>

<style>
  .particle-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }
  .particle-bg canvas {
    display: block;
  }
</style>
