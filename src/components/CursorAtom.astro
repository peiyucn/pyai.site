---
// 原子风格自定义鼠标光标：中心核 + 轨道 + 绕转电子
// 原子核跟手（即时跟随）；轨道+电子有延迟拖尾（弹性弹簧跟随）
// 仅首页启用；悬停在链接/按钮/输入框等交互元素上时自动恢复系统指针
---

<div class="cursor-atom" id="cursor-atom" aria-hidden="true">
  <span class="cursor-nucleus"></span>
  <span class="cursor-trail">
    <span class="cursor-orbit"><span class="cursor-electron"></span></span>
  </span>
</div>

<script is:inline>
  (() => {
    const cursor = document.getElementById('cursor-atom');
    if (!cursor) return;
    // 仅精细指针设备启用（触屏/触控板手势不显示）
    if (!window.matchMedia('(pointer: fine)').matches) return;

    // 交互元素：悬停时隐藏原子光标（不显示系统指针，靠 mouseover/out 判断）
    const INTERACTIVE =
      'a, button, input, textarea, select, [contenteditable], [role="button"], label, summary';

    let shown = false;

    function show() {
      if (shown) return;
      shown = true;
      cursor.classList.remove('cursor-hidden');
    }
    function hide() {
      if (!shown) return;
      shown = false;
      cursor.classList.add('cursor-hidden');
    }

    // ===== 分层跟随 =====
    // 原子核：直接跟鼠标（无延迟，即时到位）
    let mx = -100, my = -100;
    // 外圈（轨道+电子）：延迟插值跟随，向鼠标位置缓慢靠近（拖尾）
    let ox = -100, oy = -100;
    // 插值系数：越小拖尾越长。0.18 ≈ 每帧追 18%，明显滞后如弹簧
    const LERP = 0.18;
    let raf = 0;
    // rAF 兜底：某些环境（无头浏览器/后台标签）不驱动 rAF 时降级 setTimeout
    const rafFn = window.requestAnimationFrame
      ? (cb) => window.requestAnimationFrame(cb)
      : (cb) => setTimeout(() => cb(performance.now()), 16);

    function update() {
      ox += (mx - ox) * LERP;
      oy += (my - oy) * LERP;
      cursor.style.setProperty('--ox', ox + 'px');
      cursor.style.setProperty('--oy', oy + 'px');
      // 距离足够近则暂停 rAF，避免空转（鼠标不动时零开销）
      if (Math.abs(mx - ox) < 0.4 && Math.abs(my - oy) < 0.4) {
        ox = mx; oy = my;
        raf = 0;
        return;
      }
      raf = rafFn(update);
    }

    function onMove(e) {
      // 自愈（双向）：View Transitions 切换页面时 html 上的 has-cursor-atom 类可能残留。
      // 1) 原子光标元素已不在文档（进入内容页等）→ 移除类，恢复系统光标，避免鼠标消失。
      // 2) 元素还在但类丢失（abort 返回首页）→ 补上类，恢复原子光标。
      if (!document.contains(cursor)) {
        document.documentElement.classList.remove('has-cursor-atom');
        return;
      }
      if (!document.documentElement.classList.contains('has-cursor-atom')) {
        document.documentElement.classList.add('has-cursor-atom');
        shown = false;      // 重置隐藏状态，强制恢复显示
        show();
      }
      // 原子核即时跟手
      mx = e.clientX;
      my = e.clientY;
      cursor.style.setProperty('--mx', mx + 'px');
      cursor.style.setProperty('--my', my + 'px');
      // 外圈延迟追
      if (!raf) raf = rafFn(update);
    }

    // 进入/离开元素时判断一次是否交互区域，避免 mousemove 高频 DOM 遍历
    function onOver(e) {
      const el = e.target instanceof Element ? e.target : null;
      const onInteractive = el ? !!el.closest(INTERACTIVE) : false;
      if (onInteractive) hide();
      else show();
    }

    function onDown() {
      cursor.classList.add('cursor-down');
    }
    function onUp() {
      cursor.classList.remove('cursor-down');
    }
    function onLeave() {
      cursor.style.opacity = '0';
    }
    function onEnter() {
      cursor.style.opacity = '1';
    }

    window.addEventListener('mousemove', onMove, { passive: true });
    window.addEventListener('mouseover', onOver, { passive: true });
    window.addEventListener('mousedown', onDown);
    window.addEventListener('mouseup', onUp);
    document.documentElement.addEventListener('mouseleave', onLeave);
    document.documentElement.addEventListener('mouseenter', onEnter);
    // 标记启用：CSS 据此隐藏系统光标
    document.documentElement.classList.add('has-cursor-atom');
    show();
  })();

  // Astro View Transitions：每次页面切换后同步原子光标状态。
  // - 当前页无原子光标元素（内容页）→ 移除 has-cursor-atom，恢复系统光标
  // - 当前页有元素但类缺失（首页）→ 补上，确保原子光标显示
  document.addEventListener('astro:page-load', () => {
    const el = document.getElementById('cursor-atom');
    if (!el) {
      document.documentElement.classList.remove('has-cursor-atom');
      return;
    }
    if (!window.matchMedia('(pointer: fine)').matches) return;
    document.documentElement.classList.add('has-cursor-atom');
    el.classList.remove('cursor-hidden');
  });
</script>

<style>
  /* 启用原子光标后隐藏系统光标：所有元素包括交互元素都用 none，
     原子光标自身负责“交互状态隐藏”，不依赖系统指针 */
  :global(html.has-cursor-atom),
  :global(html.has-cursor-atom body),
  :global(html.has-cursor-atom *),
  :global(html.has-cursor-atom a),
  :global(html.has-cursor-atom button),
  :global(html.has-cursor-atom input),
  :global(html.has-cursor-atom textarea),
  :global(html.has-cursor-atom select),
  :global(html.has-cursor-atom [contenteditable]),
  :global(html.has-cursor-atom [role="button"]) {
    cursor: none !important;
  }

  .cursor-atom {
    position: fixed;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    z-index: 99999;
    pointer-events: none;
    opacity: 1;
    /* 仅 opacity 过渡；位置由 --mx/--my（核）与 --ox/--oy（外圈）变量控制 */
    transition: opacity 0.2s ease;
  }
  .cursor-atom.cursor-hidden {
    opacity: 0;
  }

  /* 中心核：黑色实心圆点，直接跟手（--mx/--my 即时更新） */
  .cursor-nucleus {
    position: absolute;
    width: 8px;
    height: 8px;
    left: 0;
    top: 0;
    /* 中心对准鼠标：-4px 偏移 + 变量定位 */
    transform: translate3d(calc(var(--mx, -100px) - 4px), calc(var(--my, -100px) - 4px), 0);
    background: #18181b;
    border-radius: 50%;
    box-shadow: 0 0 5px rgba(24, 24, 27, 0.5);
  }

  /* 外圈（轨道+电子）：延迟拖尾，向鼠标缓慢靠近（--ox/--oy 插值更新） */
  .cursor-trail {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate3d(calc(var(--ox, -100px) - 16px), calc(var(--oy, -100px) - 16px), 0);
  }

  /* 轨道：黑色细圆圈，整体匀速旋转；电子作为子元素随其公转 */
  .cursor-orbit {
    /* span 默认 inline，宽高不生效会塌成竖线 → 必须 display: block */
    display: block;
    width: 32px;
    height: 32px;
    border: 1.5px solid rgba(24, 24, 27, 0.55);
    border-radius: 50%;
    animation: cursor-orbit-spin 2.4s linear infinite;
  }

  /* 电子：黑色小圆点，钉在轨道线上（中心到圆心距离 = 轨道中心线半径 15.25px），随轨道旋转公转 */
  .cursor-electron {
    position: absolute;
    width: 4px;
    height: 4px;
    left: 50%;
    top: 50%;
    margin: -2px 0 0 -2px;
    /* 从圆心沿 -Y 移到轨道中心线上：轨道 32px(border-box) → 半径 16px，中心线 16 - 0.75 = 15.25px */
    transform: translateY(-15.25px);
    background: #18181b;
    border-radius: 50%;
    box-shadow: 0 0 4px rgba(24, 24, 27, 0.55);
  }

  @keyframes cursor-orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
