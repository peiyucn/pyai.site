---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { Post } from '../utils/content';
import { formatDate, stripLocale } from '../utils/content';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const url = `/${locale}/blog/${stripLocale(post.id)}/`;
---

<article
  class="group border-b border-zinc-200 py-6 last:border-b-0 dark:border-zinc-800"
>
  <a href={url} class="block hover:no-underline">
    <h2
      class="text-xl font-bold leading-snug text-zinc-900 transition-colors group-hover:text-accent dark:text-zinc-100"
    >
      {post.data.title}
    </h2>
    {
      post.data.description && (
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">
          {post.data.description}
        </p>
      )
    }
  </a>
  <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-zinc-400 dark:text-zinc-500">
    <time datetime={post.data.date.toISOString()}>
      {formatDate(post.data.date, locale)}
    </time>
    {
      post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {
            post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)
          }
        </div>
      )
    }
    <a
      href={url}
      class="ml-auto font-medium text-accent hover:underline dark:text-indigo-400"
    >
      {t(locale, 'common.readMore')} →
    </a>
  </div>
</article>
