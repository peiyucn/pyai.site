---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { Note } from '../utils/content';
import { formatDate, stripLocale } from '../utils/content';

interface Props {
  note: Note;
  locale: Locale;
}

const { note, locale } = Astro.props;
const url = `/${locale}/notes/${stripLocale(note.id)}/`;
---

<article
  class="group border-b border-zinc-200 py-5 last:border-b-0"
>
  <a href={url} class="block hover:no-underline">
    <h2
      class="text-lg font-semibold leading-snug text-zinc-900 transition-colors group-hover:text-accent"
    >
      {note.data.title}
    </h2>
    {
      note.data.description && (
        <p class="mt-1 text-sm leading-relaxed text-zinc-500">
          {note.data.description}
        </p>
      )
    }
  </a>
  <div class="mt-2.5 flex flex-wrap items-center gap-3 text-xs text-zinc-400">
    <time datetime={note.data.date.toISOString()}>
      {formatDate(note.data.date, locale)}
    </time>
    {
      note.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {
            note.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)
          }
        </div>
      )
    }
    <a
      href={url}
      class="ml-auto font-medium text-accent hover:underline"
    >
      {t(locale, 'common.readMore')} →
    </a>
  </div>
</article>
