---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="tagline">{t(locale, 'footer.tagline')}</p>
    <p class="copyright">© {year} pyai.site · {t(locale, 'footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding: 2rem 0;
  }
  .footer-inner {
    text-align: center;
  }
  .tagline {
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin: 0 0 0.35em;
  }
  .copyright {
    color: var(--fg-muted);
    font-size: 0.8rem;
    margin: 0;
    opacity: 0.8;
  }
</style>
