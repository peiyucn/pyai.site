---
import Pagination from './Pagination.astro';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { Movie } from '../utils/douban';
import { formatDate } from '../utils/content';

interface Props {
  movies: Movie[];
  locale: Locale;
  total: number;
  currentPage: number;
  totalPages: number;
  /** 当前影/剧筛选：'all' | 'films' | 'series' */
  filter?: 'all' | 'films' | 'series';
}

const { movies, locale, total, currentPage, totalPages, filter = 'all' } = Astro.props;

const statusLabel: Record<string, string> = {
  看过: t(locale, 'movies.watched'),
  在看: t(locale, 'movies.watching'),
  想看: t(locale, 'movies.wishlist'),
};

/** 筛选标签配置：all / films / series（路径参数，静态生成友好） */
const filterTabs: { key: 'all' | 'films' | 'series'; label: string; href: string }[] = [
  { key: 'all', label: t(locale, 'movies.filterAll'), href: `/${locale}/movies/` },
  { key: 'films', label: t(locale, 'movies.filterMovie'), href: `/${locale}/movies/films/` },
  { key: 'series', label: t(locale, 'movies.filterTv'), href: `/${locale}/movies/series/` },
];
---

<div class="mb-6 flex items-center justify-between">
  <p class="text-sm text-zinc-400">
    {t(locale, 'movies.total')} {total}
  </p>
  <a
    href={`/${locale}/movies/stats/`}
    class="text-sm text-accent hover:underline"
  >
    {t(locale, 'movies.viewStats')} →
  </a>
</div>

{/* 影/剧筛选标签：与记录页标签筛选同风格（小胶囊 + 选中黑底白字 + hover 灰底） */}
<div class="mb-4 flex flex-wrap items-center gap-1.5">
  {
    filterTabs.map((tab) => (
      <a
        href={tab.href}
        class:list={[
          'rounded-full border px-2.5 py-1 text-xs transition-colors hover:no-underline',
          filter === tab.key
            ? 'border-accent bg-accent font-semibold text-[#2a1a06]'
            : 'border-white/10 text-zinc-400 hover:bg-white/10 hover:text-zinc-100',
        ]}
      >
        {tab.label}
      </a>
    ))
  }
</div>

{/* 顶部翻页 */}
<Pagination
  locale={locale}
  currentPage={currentPage}
  totalPages={totalPages}
  filter={filter}
/>

{
  movies.length > 0 ? (
    <>
      <ul class="divide-y divide-white/10">
        {
          movies.map((movie) => {
            const isWatched = movie.data.status === '看过';
            // 看过 → 显示“何时看过”（浅色小字）；其他状态 → 浅色药丸
            const watchedLabel = isWatched
              ? locale === 'zh'
                ? `${formatDate(movie.data.date, locale)} ${t(locale, 'movies.watched')}`
                : `${t(locale, 'movies.watched')} ${formatDate(movie.data.date, locale)}`
              : (statusLabel[movie.data.status] ?? movie.data.status);

            const metaLine = [
              movie.data.year,
              movie.data.country,
              movie.data.director,
              movie.data.genre,
            ]
              .filter(Boolean)
              .join(' · ');

            return (
              <li class="flex items-baseline gap-4 py-2.5">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
                    <a
                      href={movie.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-zinc-50 transition-colors hover:text-accent"
                    >
                      {movie.data.title}
                    </a>
                    {
                      isWatched ? (
                        <span class="shrink-0 text-xs text-zinc-500">{watchedLabel}</span>
                      ) : (
                        <span
                          class="shrink-0 rounded-full border border-white/10 bg-white/5 px-2 py-0.5 text-xs text-zinc-400"
                        >
                          {watchedLabel}
                        </span>
                      )
                    }
                  </div>
                  {metaLine && (
                    <p class="mt-0.5 truncate text-xs text-zinc-500">{metaLine}</p>
                  )}
                  {movie.data.comment && (
                    <p class="mt-0.5 truncate text-sm text-zinc-400">
                      “{movie.data.comment}”
                    </p>
                  )}
                </div>
                <div class="shrink-0 text-right">
                  <p
                    class="text-sm tracking-tighter text-amber-500"
                    aria-label={movie.data.rating + '/5'}
                  >
                    {'★'.repeat(movie.data.rating)}
                    <span class="text-zinc-600">{'★'.repeat(5 - movie.data.rating)}</span>
                  </p>
                  {movie.data.doubanRating > 0 && (
                    <p class="mt-0.5 text-xs text-zinc-500">
                      {t(locale, 'movies.douban')}{' '}
                      <span class="font-medium text-zinc-300">
                        {movie.data.doubanRating.toFixed(1)}
                      </span>
                    </p>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>

      {/* 底部翻页 */}
      <div class="mt-8">
        <Pagination
          locale={locale}
          currentPage={currentPage}
          totalPages={totalPages}
          filter={filter}
        />
      </div>
    </>
  ) : (
    <p class="text-sm text-zinc-400">{t(locale, 'common.noContent')}</p>
  )
}
