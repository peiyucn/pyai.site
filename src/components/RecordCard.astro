---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';
import type { Record } from '../utils/content';
import { formatDate, stripLocale } from '../utils/content';

interface Props {
  record: Record;
  locale: Locale;
}

const { record, locale } = Astro.props;
const url = `/${locale}/records/${stripLocale(record.id)}/`;
---

<article
  class="group py-6"
>
  <a href={url} class="block hover:no-underline">
    <h2
      class="text-xl font-bold leading-snug text-zinc-50 transition-colors group-hover:text-accent"
    >
      {record.data.title}
    </h2>
    {
      record.data.description && (
        <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">
          {record.data.description}
        </p>
      )
    }
  </a>
  <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-zinc-500">
    <time datetime={record.data.date.toISOString()}>
      {formatDate(record.data.date, locale)}
    </time>
    {
      record.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {
            record.data.tags.slice(0, 3).map((tag) => (
              <span class="tag" aria-hidden="true">{tag}</span>
            ))
          }
        </div>
      )
    }
  </div>
</article>
