---
import { languages, type Locale } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const other: Locale = locale === 'zh' ? 'en' : 'zh';
---

<a href={localizePath(pathname, other)} class="lang-switch" aria-label={`Switch to ${languages[other]}`}>
  <svg
    class="lang-switch-icon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="9" />
    <path d="M3 12h18" />
    <path d="M12 3a14.5 14.5 0 0 1 0 18 14.5 14.5 0 0 1 0-18z" />
  </svg>
  {languages[other]}
</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.88rem;
    font-weight: 500;
    color: #18181b; /* 黑色图标+文字 */
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25em 0.9em;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
  .lang-switch-icon {
    width: 0.95em;
    height: 0.95em;
    flex-shrink: 0;
  }
</style>
