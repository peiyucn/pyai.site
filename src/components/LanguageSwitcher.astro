---
import { localizePath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  pathname: string;
  /** 深色背景（标题栏 / 首页）下使用 */
  dark?: boolean;
}

const { locale, pathname, dark = false } = Astro.props;

const options: { code: Locale; label: string; full: string }[] = [
  { code: 'zh', label: '中', full: '中文' },
  { code: 'en', label: 'EN', full: 'English' },
];
---

<div
  class:list={['lang-switch', dark && 'lang-switch-dark']}
  role="group"
  aria-label="Language"
>
  {
    options.map((opt) => (
      <a
        href={localizePath(pathname, opt.code)}
        class:list={['lang-opt', opt.code === locale && 'lang-opt-active']}
        aria-current={opt.code === locale ? 'page' : undefined}
        aria-label={opt.full}
      >
        {opt.label}
      </a>
    ))
  }
</div>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border-radius: 999px;
    border: 1px solid rgba(24, 24, 27, 0.18);
    background: rgba(24, 24, 27, 0.04);
  }
  .lang-opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2em;
    padding: 0.18em 0.6em;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.4;
    color: #18181b;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .lang-opt:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .lang-opt-active,
  .lang-opt-active:hover {
    background: linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%);
    color: #2a1a06;
    font-weight: 600;
  }

  /* 深色标题栏 / 首页变体 */
  .lang-switch-dark {
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.05);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .lang-switch-dark .lang-opt {
    color: rgba(255, 255, 255, 0.72);
  }
  .lang-switch-dark .lang-opt:hover {
    color: #fff;
  }
  .lang-switch-dark .lang-opt-active,
  .lang-switch-dark .lang-opt-active:hover {
    background: linear-gradient(135deg, #ffd48a 0%, #f0b95e 50%, #e8a24a 100%);
    color: #2a1a06;
  }
</style>
