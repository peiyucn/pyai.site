---
// 月食 Hero 动画组件（黑底发光，源自 UnicornStudio 场景复刻）
// 结构：全宽横条场景（文字带 Record Distill Create + 金色光弧跟随鼠标 + 透镜畸变）
// 依赖（均由 scripts/extract-hero.cjs 从 pyai-site-hero.html 生成）：
//   - public/vendor/unicornstudio.js  引擎 UMD
//   - public/vendor/notosans-latin.css 文字带字体
//   - src/data/hero-scene.json         场景数据（shader 内嵌）
import { readFileSync } from 'node:fs';
import path from 'node:path';

// 场景 JSON 在构建期读取并内联（process.cwd() 在 build/dev 均为项目根 pyai.site）
const sceneJson = readFileSync(path.join(process.cwd(), 'src', 'data', 'hero-scene.json'), 'utf8');
---

<div class="moonshot-hero">
  <div
    class="moonshot-scene"
    data-us-project-src="hero-scene-data"
    data-us-scale="0.5"
    data-us-dpi="1.5"
    data-us-fps="30"
    data-us-lazyload="false"
    data-us-alttext="Hero background animation"
    aria-label="Hero background animation"
  ></div>
  <div class="moonshot-gradient" aria-hidden="true"></div>
</div>

<!-- 文字带字体 NotoSans-Latin（vendor 化，Astro 会自动提升到 <head>） -->
<link rel="stylesheet" href="/vendor/notosans-latin.css" />

<!-- 场景数据：引擎原生从 <script id="hero-scene-data"> 读取 innerText -->
<script id="hero-scene-data" type="application/json" is:inline set:html={sceneJson}></script>

<!-- UnicornStudio 引擎（vendor UMD，同步加载后立即定义 window.UnicornStudio） -->
<script is:inline src="/vendor/unicornstudio.js"></script>

<script is:inline>
  (function () {
    if (!window.UnicornStudio) return;
    var TWO_PI = Math.PI * 2;
    var MIN_ARC = Math.PI * 0.5;

    // 找到"活的"场景：优先当前 DOM 中、未销毁、元素在文档里的 scene。
    // View Transitions 返回首页时 scenes 数组可能残留旧 scene（元素已被移除），
    // 直接取 scenes[0] 会拿到死场景 → 黑洞消失的根因。
    function findLiveScene() {
      var scenes = UnicornStudio.scenes || [];
      var els = document.querySelectorAll('[data-us-project-src]');
      for (var i = 0; i < scenes.length; i++) {
        var s = scenes[i];
        if (!s || s.destroyed) continue;
        if (s.element && document.body.contains(s.element)) return s;
      }
      // 有元素但无匹配 scene（首次或 VT 后引擎未重建）：取最后一个元素对应的新 scene
      if (els.length && scenes.length) {
        var last = scenes[scenes.length - 1];
        if (last && !last.destroyed && last.element === els[els.length - 1]) return last;
      }
      return scenes.length ? scenes[0] : null;
    }

    // 清理引擎中已不在 DOM 的死场景（VT 后旧 body 已移除）。
    // 仅当元素确实不在文档且非当前激活场景时才销毁，避免 VT 过渡瞬间误杀。
    function disposeDeadScenes() {
      var scenes = UnicornStudio.scenes || [];
      var liveEls = [];
      var els = document.querySelectorAll('[data-us-project-src]');
      for (var k = 0; k < els.length; k++) liveEls.push(els[k]);
      for (var i = scenes.length - 1; i >= 0; i--) {
        var s = scenes[i];
        if (!s || s.destroyed) continue;
        var el = s.element;
        // 元素在 DOM（含当前激活）→ 不销毁
        if (el && document.body.contains(el)) continue;
        // 元素已被移除（旧页面残留）→ 销毁释放
        if (el) {
          try { s.destroy(); } catch (e) {}
        }
      }
    }

    // 初始化兜底：引擎 init 可能早于布局完成（offsetWidth=0 → canvas 1px → 卡 initializing）。
    // 轮询等待元素有真实尺寸后再 resize + initializePlanes；并处理 initializing 卡死。
    var bootTries = 0;
    var MAX_TRIES = 100; // 10s 上限（100ms × 100）
    function elSize() {
      var el = document.querySelector('.moonshot-scene[data-us-project-src]');
      if (!el) return null;
      var r = el.getBoundingClientRect();
      return { w: r.width || el.offsetWidth, h: r.height || el.offsetHeight };
    }
    // 强制完成初始化：引擎 checkIfReady 依赖 rAF 递归等 planes.isReady，
    // 后台标签/某些环境下 rAF 不驱动 → initializing 永远卡 true。
    // 手动完成 planes 创建 + 纹理绑定，并直接标记 isReady 跳过 rAF 等待。
    function forceInit(scene) {
      if (scene.initialized) return true;
      try {
        // 重置卡死状态
        scene.initializing = false;
        scene.initialized = false;
        // 已建过 planes 则跳过创建（避免重复）
        var hasPlanes = scene.curtain && scene.curtain.planes && scene.curtain.planes.length > 0;
        if (!hasPlanes) {
          if (scene.handleItemPlanes) {
            scene.handleItemPlanes();
          } else {
            scene.createPlanes();
            scene.createTextures();
          }
        } else if (scene.createTextures) {
          try { scene.createTextures(); } catch (e) {}
        }
        // 标记所有 plane ready（跳过 rAF 等 isReady）
        if (scene.curtain && scene.curtain.planes) {
          scene.curtain.planes.forEach(function (p) {
            if (p.userData) p.userData.isReady = true;
          });
        }
        // 完成初始化收尾
        if (scene.handlePlaneCreation) {
          try { scene.handlePlaneCreation(); } catch (e) {}
        }
        scene.initializing = false;
        scene.initialized = true;
        try { scene.renderFrame(); } catch (e) {}
        return true;
      } catch (e) {
        return false;
      }
    }
    function boot() {
      disposeDeadScenes();
      var el = document.querySelector('.moonshot-scene[data-us-project-src]');
      if (!el) { if (bootTries++ < MAX_TRIES) setTimeout(boot, 100); return; }
      var scene = findLiveScene();
      if (!scene) {
        // 场景不存在：清除可能残留的初始化标记后重新 init（VT 后引擎可能没为新元素创建 scene）
        el.removeAttribute('data-us-initialized');
        UnicornStudio.init().then(function () { setTimeout(boot, 50); });
        return;
      }
      var sz = elSize();
      if (!sz || sz.w < 10 || sz.h < 10) {
        // 元素尺寸未就绪（VT 返回瞬间 / 后台标签），轮询等待
        if (bootTries++ < MAX_TRIES) setTimeout(boot, 100);
        return;
      }
      // 尺寸就绪：修正 canvas 尺寸并初始化
      if (scene.initializing && !scene.initialized) {
        // 卡死：强制重置 initializing（引擎可能因 canvas 1px 卡在 handleItemPlanes）
        scene.initializing = false;
      }
      try { scene.resize(); } catch (e) {}
      var ok = forceInit(scene);
      if (!ok && bootTries++ < MAX_TRIES) setTimeout(boot, 100);
    }

    // 首次加载：直接 init 后 boot
    UnicornStudio.init().then(function () {
      setTimeout(boot, 60);
    });
    // View Transitions：每次页面切换（含返回/中英切换）后重新 boot，恢复黑洞
    document.addEventListener('astro:page-load', function () {
      bootTries = 0;
      setTimeout(boot, 60);
    });

    // beam 动态参数：黑洞吸积盘"太阳在后面移动"效果
    //   - 鼠标在中心 → uBeamArc=TWO_PI 满圈（完整日全食圆环）
    //   - 鼠标偏移 → 弧长线性缩短（太阳被遮挡），弧变粗（吸积盘增亮）
    //   - 光弧缺口方向跟随鼠标方向（uBeamAngle = 鼠标方向）
    //   - 圆心轻微跟随鼠标位移（shader 内 0.12 系数，已内置，无需 JS）
    //   同时修复 resize：引擎的 refresh 依赖 rAF 异步，窗口变化时手动 resize 兜底。
    (function () {
      var tries = 0;
      function install() {
        var scene = findLiveScene();
        if (!scene || !scene.curtain || !scene.curtain.planes) {
          if (tries++ < 400) setTimeout(install, 50);
          return;
        }
        var beamPlane = null;
        scene.curtain.planes.forEach(function (p) {
          if (p.userData && p.userData.type === 'beam') beamPlane = p;
        });
        if (!beamPlane || !beamPlane.uniforms) {
          if (tries++ < 200) setTimeout(install, 50);
          return;
        }
        if (!beamPlane.uniforms.beamStrength) {
          beamPlane.uniforms.beamStrength = { name: 'uBeamStrength', type: '1f', value: 1.0 };
        }
        if (!beamPlane.uniforms.beamAngle) {
          beamPlane.uniforms.beamAngle = { name: 'uBeamAngle', type: '1f', value: 0.0 };
        }
        if (!beamPlane.uniforms.beamArc) {
          beamPlane.uniforms.beamArc = { name: 'uBeamArc', type: '1f', value: TWO_PI };
        }
        if (!beamPlane.uniforms.beamThickness) {
          beamPlane.uniforms.beamThickness = { name: 'uBeamThickness', type: '1f', value: 0.3 };
        }
        // 强度固定 1.0（GLSL 默认 0 会导致光弧消失）
        beamPlane.uniforms.beamStrength.value = 1.0;
        if (beamPlane._pyaiBeamHook) return;
        beamPlane._pyaiBeamHook = true;
        // 平滑角度/弧长/粗细：三者同 alpha 插值避免撕裂；角度走最短角差防跨 π 跳变
        var smoothAngle = 0.0;
        var smoothArc = TWO_PI;
        var smoothThickness = 0.3;
        var lastT = null;
        beamPlane.onRender(function () {
          try {
            var mu = beamPlane.uniforms.mousePos && beamPlane.uniforms.mousePos.value;
            if (!mu) return;
            var mx = mu._x !== undefined ? mu._x : mu.x;
            var my = mu._y !== undefined ? mu._y : mu.y;
            // 鼠标离中心 (0.5, 0.5) 的偏移（上=+y，右=+x，与 shader 角度空间一致）
            var dx = mx - 0.5;
            var dy = my - 0.5;
            var dist = Math.sqrt(dx * dx + dy * dy);
            var offset = Math.min(1.0, dist * 2.0); // 灵敏度：边角 dist≈0.707 → offset≈1
            // 目标弧长（中心满圈 → 偏移线性缩短）、粗细（略变粗）
            var targetArc = TWO_PI - offset * (TWO_PI - MIN_ARC);
            var targetThickness = 0.3 + offset * 0.35;
            // 缺口方向 = 鼠标方向
            var target = Math.atan2(dy, dx);
            if (target < 0) target += TWO_PI;
            // 同步平滑
            var now = performance.now();
            var dt = lastT !== null ? (now - lastT) / 1000 : 0.016;
            if (dt > 0.1) dt = 0.1;
            lastT = now;
            var alpha = 1 - Math.exp(-12 * dt);
            var diff = target - smoothAngle;
            diff = Math.atan2(Math.sin(diff), Math.cos(diff));
            smoothAngle += diff * alpha;
            smoothAngle = (smoothAngle + TWO_PI) % TWO_PI;
            smoothArc += (targetArc - smoothArc) * alpha;
            smoothThickness += (targetThickness - smoothThickness) * alpha;
            beamPlane.uniforms.beamAngle.value = smoothAngle;
            beamPlane.uniforms.beamArc.value = smoothArc;
            beamPlane.uniforms.beamThickness.value = smoothThickness;
          } catch (e) {}
        });
      }
      install();

      // resize 兜底：窗口尺寸变化时手动 resize 场景，并强制文字层重绘复位。
      // 引擎的 resize 只更新 canvas 尺寸，text 层的 canvas 纹理需要额外刷新
      //（否则 pyai.site 文字在窗口变化后停在旧尺寸/位置——"不能复位"的根因）。
      // 用防抖 50ms 确保在引擎 debounce(16ms) 之后修正尺寸。
      var resizeTimer = null;
      function doResize() {
        var scene = findLiveScene();
        if (!scene || !scene.resize) return;
        try { scene.resize(); } catch (e) {}
        // 强制文字层纹理重绘：text 层本地 canvas 尺寸跟随 canvasWidth/Height，
        // 标记 shouldUpdate 让引擎下一帧重传纹理 → pyai.site 复位
        var layers = scene.layers || [];
        for (var i = 0; i < layers.length; i++) {
          var layer = layers[i];
          if (layer && layer.layerType === 'text' && layer.preloadedCanvasTexture) {
            layer.preloadedCanvasTexture.shouldUpdate = true;
          }
        }
        try { scene.renderFrame(); } catch (e) {}
      }
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(doResize, 50);
      });
    })();
  })();
</script>

<style>
  .moonshot-hero {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }
  .moonshot-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
  }
  .moonshot-scene :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  /* 底部渐变：黑 → 透明，让动画底部自然融入 hero 黑底（原版 linear-gradient to top #000 37.366%） */
  .moonshot-gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50%;
    background: linear-gradient(to top, #000 37.366%, transparent);
    pointer-events: none;
  }
</style>
